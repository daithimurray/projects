{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "Errol Brennan Painting", "version": "1.0.0", "updated": "2026-09-23" },
  "color": {
    "ink": { "50": "#F1F4F7", "100": "#DCE3EA", "200": "#B9C6D4", "300": "#8FA3B8", "400": "#64809B", "500": "#46627E", "600": "#34506A", "700": "#263D52", "800": "#1B2C3D", "900": "#111D29" },
    "ochre": { "50": "#FBF4E6", "100": "#F5E4BF", "200": "#ECCB85", "300": "#E1B04F", "400": "#D49A2C", "500": "#C08420", "600": "#9E6B19", "700": "#7C5314", "800": "#5C3D0F", "900": "#3E290A" },
    "plaster": { "0": "#FFFFFF", "50": "#FAF8F5", "100": "#F3F0EB", "200": "#E6E1D9", "300": "#D1CAC0", "400": "#A9A198", "500": "#7E776F", "600": "#5E5851", "700": "#433F3A", "800": "#2B2825", "900": "#1A1816" },
    "success": { "500": "#2E7D4F", "text": "#1F5C38", "bg": "#E6F3EB" },
    "warning": { "500": "#B7791F", "text": "#7A4E0E", "bg": "#FBF1DC" },
    "error":   { "500": "#B3261E", "text": "#8A1C16", "bg": "#FBE9E7" },
    "info":    { "500": "#2B6CB0", "text": "#1E4E80", "bg": "#E6EFF9" }
  },
  "semantic": {
    "bg": { "page": "{color.plaster.50}", "surface": "{color.plaster.0}", "muted": "{color.plaster.100}", "inverse": "{color.ink.800}", "accent": "{color.ochre.400}", "accent-soft": "{color.ochre.50}" },
    "text": { "primary": "{color.plaster.900}", "secondary": "{color.plaster.600}", "placeholder": "{color.plaster.500}", "heading": "{color.ink.900}", "on-inverse": "#FFFFFF", "on-inverse-muted": "{color.ink.100}", "on-accent": "{color.plaster.900}", "accent": "{color.ochre.600}", "link": "{color.ink.600}", "link-hover": "{color.ink.800}", "link-on-inverse": "{color.ochre.200}" },
    "border": { "default": "{color.plaster.200}", "strong": "{color.plaster.300}", "control": "{color.plaster.500}", "on-inverse": "rgba(255,255,255,0.12)", "focus": "{color.ink.500}", "focus-on-inverse": "{color.ochre.300}" },
    "action": { "primary": "{color.ink.800}", "primary-hover": "{color.ink.700}", "primary-active": "{color.ink.900}", "primary-on-inverse": "{color.ochre.400}", "primary-on-inverse-hover": "{color.ochre.300}", "disabled-bg": "{color.plaster.200}", "disabled-text": "{color.plaster.400}" }
  },
  "font": {
    "family": { "display": "'Newsreader', Georgia, serif", "body": "'Figtree', system-ui, sans-serif", "mono": "'JetBrains Mono', ui-monospace, monospace" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "display": "clamp(2.75rem, 6vw, 5rem)", "h1": "clamp(2.25rem, 4.5vw, 3.5rem)", "h2": "clamp(1.75rem, 3.2vw, 2.5rem)", "h3": "clamp(1.375rem, 2.4vw, 1.75rem)", "h4": "1.25rem",
      "body-lg": "1.125rem", "body": "1rem", "small": "0.875rem", "caption": "0.75rem"
    },
    "line-height": { "display": 1.0, "h1": 1.1, "h2": 1.15, "h3": 1.25, "h4": 1.3, "body-lg": 1.6, "body": 1.6, "small": 1.5, "caption": 1.4 },
    "letter-spacing": { "display": "-0.02em", "h1": "-0.02em", "h2": "-0.01em", "caption": "0.1em" }
  },
  "space": { "0.5": "4px", "1": "8px", "1.5": "12px", "2": "16px", "3": "24px", "4": "32px", "6": "48px", "8": "64px", "12": "96px", "16": "128px" },
  "radius": { "1": "4px", "2": "8px", "3": "12px", "full": "999px" },
  "shadow": { "sm": "0 1px 2px rgba(26,24,22,0.08)", "md": "0 4px 12px rgba(26,24,22,0.12)", "lg": "0 12px 32px rgba(26,24,22,0.16)" },
  "motion": {
    "duration": { "fast": "150ms", "base": "250ms", "slow": "400ms" },
    "easing": { "out": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0.4, 0, 0.2, 1)" }
  },
  "layout": {
    "container": "1200px", "columns": 12, "gutter": "24px",
    "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
    "margin": { "xs": "16px", "sm": "24px", "md": "32px", "lg": "48px" }
  },
  "size": { "control-sm": "40px", "control-md": "48px", "control-lg": "56px", "target-min": "48px", "icon-sm": "16px", "icon-md": "20px", "icon-lg": "24px", "navbar": "72px", "navbar-mobile": "64px" },
  "z": { "sticky": 40, "nav": 50, "tooltip": 60, "overlay": 100 }
}
