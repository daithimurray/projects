---
import '../styles/tokens.css';
import '../styles/base.css';
import archivoWdth from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import atkinson from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import atkinsonItalic from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-italic.woff2?url';
import martian from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url';
import { company, ui } from '../data/content.js';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = '' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(`${base}${path}`, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const noindex = import.meta.env.PUBLIC_NOINDEX !== '0';
// The design contract is for the build and review process, not for visitors:
// it's emitted in dev and in review builds (PUBLIC_DESIGN_CONTRACT=1) only.
const showContract = import.meta.env.DEV || import.meta.env.PUBLIC_DESIGN_CONTRACT === '1';

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Archivo Variable';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivoWdth}) format('woff2-variations');unicode-range:${latin}}
@font-face{font-family:'Atkinson Hyperlegible Next Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${atkinson}) format('woff2-variations');unicode-range:${latin}}
@font-face{font-family:'Atkinson Hyperlegible Next Variable';font-style:italic;font-display:swap;font-weight:200 800;src:url(${atkinsonItalic}) format('woff2-variations');unicode-range:${latin}}
@font-face{font-family:'Martian Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;font-stretch:75% 112.5%;src:url(${martian}) format('woff2-variations');unicode-range:${latin}}
`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${canonical}#business`,
  name: company.name,
  legalName: company.legalName,
  alternateName: 'Amptech Security Systems',
  description:
    'PSA-licensed installer of intruder alarms, CCTV, fire detection and security lighting for homes and businesses. Based in Leixlip, Co. Kildare.',
  url: canonical,
  telephone: company.phoneIntl,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    addressLocality: company.address.town,
    addressRegion: company.address.county,
    postalCode: company.eircode,
    addressCountry: company.address.postalCountry,
  },
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  areaServed: [
    ...company.areas.map((name) => ({ '@type': 'AdministrativeArea', name: `County ${name}` })),
    { '@type': 'Country', name: 'Ireland' },
  ],
  knowsAbout: [
    'Intruder alarms',
    'CCTV',
    'Fire detection',
    'Security lighting',
    'Access control',
    'Alarm upgrades',
    'Alarm maintenance',
    'Alarm monitoring',
    'HKC alarm systems',
  ],
};
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0c1628" />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={archivoWdth} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinson} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    {showContract && <Fragment set:html={`<!--
THESIS: A Kildare estate after dark, where light does the selling. Sensors trip, floodlights snap on, cameras turn, alerts arrive: detection shown, not claimed. Refuses navy, shields, stock camera photos and a grid of service cards.
OWN-WORLD: Dusk-blue night under a sodium-lit overcast sky. Sodium amber is the only warm accent; floodlight white lights the dense panels; bell-box blue is kept for alerts. Pebbledash, slate, tarmac, tungsten windows. Wide Archivo display, Atkinson Hyperlegible body, Martian Mono only for time, zones and licence numbers.
STORY: A homeowner sees their own estate, trips a sensor, follows a system room by room, sees an old alarm upgraded, trusts PSA 03019 and the certificate, and calls 01 615 5980.
FIRST VIEWPORT: Full-bleed three.js estate. "Nobody reaches the door unseen." lower left, up to 6rem. Call and quote buttons beneath, then the licence line. CCTV timestamp top right. Moving onto the driveway trips the floodlight and the camera follows.
FORM: grounded candidate 4 of 7 (night estate under security lighting); seed 5bd57afc (degraded roll).
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`} />}
    <a class="skip-link" href="#main">{ui.skip}</a>
    <slot />
  </body>
</html>
