---
// Authored icon set: 24px grid, 1.6 stroke, round caps and joins.
// Drawn from the hardware Amptech fits, so icons belong to the page's world.
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;

const paths: Record<string, string> = {
  phone:
    '<g class="icon-ring"><path d="M6.6 3.5h2.2l1.4 4-2 1.4a12 12 0 0 0 6.9 6.9l1.4-2 4 1.4v2.2a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1Z"/></g>',
  arrow: '<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  'arrow-down': '<path d="M12 4.5v15"/><path d="m6 13.5 6 6 6-6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8.5 7H17v8.5"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h10"/>',
  close: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
  // PIR motion detector: the lens dome and its fan of detection
  pir:
    '<path d="M8 3.5h8a1.5 1.5 0 0 1 1.5 1.5v4a5.5 5.5 0 0 1-11 0V5A1.5 1.5 0 0 1 8 3.5Z"/><circle cx="12" cy="9" r="1.6"/><path d="M6 17.5 12 20.5l6-3" opacity=".55"/><path d="M8.5 15.5 12 17.2l3.5-1.7" opacity=".8"/>',
  camera:
    '<path d="M3.5 8.5 15 5l1.6 5.4-11.5 3.4Z"/><path d="m16.6 7.2 3.4-1v5l-3.4 1"/><path d="M8 13.3 9 17"/><path d="M5.5 17.5h6"/>',
  smoke:
    '<circle cx="12" cy="8" r="5.5"/><circle cx="12" cy="8" r="1.5"/><path d="M9 17.5c1-1 2-1 3 0s2 1 3 0"/><path d="M8 20.5c1.3-1 2.7-1 4 0s2.7 1 4 0"/>',
  flood:
    '<path d="M4 5.5h7v5H4Z"/><path d="M11 6.5 13 5v6l-2-1.5"/><path d="M7.5 10.5V13"/><path d="M14.5 13.5l5 5" /><path d="M14 16.5l3 4"/><path d="M15.5 11.5l5 2"/>',
  bellbox:
    '<path d="M6 3.5h12a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19V5A1.5 1.5 0 0 1 6 3.5Z"/><path d="M9 3.5v3h6v-3"/><path d="M8 11h8"/><path d="M8 14h8"/>',
  door:
    '<path d="M6 20.5V4.5A1 1 0 0 1 7 3.5h10a1 1 0 0 1 1 1v16"/><path d="M4 20.5h16"/><circle cx="15" cy="12.5" r=".9"/><path d="M19.5 9.5h1.5v5h-1.5"/>',
  app:
    '<rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/><path d="M10.5 18.5h3"/><path d="M9.5 8.5h5"/><path d="M9.5 11.5h3.5"/>',
  wrench:
    '<path d="M14.5 4a4.5 4.5 0 0 0-4.2 6.1l-6 6a1.8 1.8 0 0 0 2.6 2.6l6-6A4.5 4.5 0 0 0 19.5 8l-2.8 2.8-2.5-.7-.7-2.5L16.3 4.8A4.5 4.5 0 0 0 14.5 4Z"/>',
  service:
    '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
  pin:
    '<path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.8"/><path d="m4 7 8 6 8-6"/>',
  certificate:
    '<path d="M5.5 3.5h13v13h-13Z"/><path d="M8.5 7.5h7"/><path d="M8.5 10.5h4"/><circle cx="15" cy="16.5" r="2.5"/><path d="m13.8 18.8-.8 2.7 2-1 2 1-.8-2.7"/>',
  licence:
    '<rect x="3.5" y="5.5" width="17" height="13" rx="1.8"/><circle cx="9" cy="11" r="2"/><path d="M6.2 15.8a3.2 3.2 0 0 1 5.6 0"/><path d="M14 10h4"/><path d="M14 13h3"/>',
  alert:
    '<path d="M12 4.5 20.5 19h-17Z"/><path d="M12 10v4"/><path d="M12 16.6v.2"/>',
  home: '<path d="M4 11 12 4l8 7"/><path d="M6 9.5v10h12v-10"/><path d="M10 19.5v-5h4v5"/>',
  business: '<path d="M4 20.5h16"/><path d="M6 20.5V6.5l6-3v17"/><path d="M12 9.5h6v11"/><path d="M8.5 9h1"/><path d="M8.5 12.5h1"/><path d="M8.5 16h1"/><path d="M14.5 13h1"/><path d="M14.5 16.5h1"/>',
  // Notification bell: swings like the phone icon when hovered inside a .btn
  bell:
    '<g class="icon-ring"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 2h-14Z"/><path d="M10 20.5a2.2 2.2 0 0 0 4 0"/><path d="M12 3.8v1.7"/></g>',
  // Armed: a padlock, the state the panel is in
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>',
};

const body = paths[name];
if (!body) throw new Error(`Icon "${name}" is not in the set`);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
