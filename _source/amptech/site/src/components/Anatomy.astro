            <!-- Locator: pings a device's position when its step is hovered -->
            <circle class="an-ping" cx="0" cy="0" r="12" {...ns} data-an-ping />

            <!-- Cam 1 picture-in-picture: monochrome IR frame of the driveway -->
            <g class="an-inset" data-dev="2" data-state="calm" data-an-inset>
              <g clip-path="url(#an-c-inset)">
