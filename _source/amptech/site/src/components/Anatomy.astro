---
// "How it works": an installer's survey drawing of a typical semi-detached
// house, cut open so both floors show. Each step switches on its devices.
// Static HTML is the finished, fully armed drawing; motion only adds to it.
import Icon from './Icon.astro';
import { anatomy, anatomyArt } from '../data/content.js';

const steps = anatomy.steps;
const up = (s: string) => s.toUpperCase();
const f = (n: number) => Math.round(n * 10) / 10;
// Hairlines stay hairlines at any drawing size (DrawSVG reads this attribute).
const ns = { 'vector-effect': 'non-scaling-stroke' };

// Footnote: the standard's number is data.
const [footA, footB] = anatomy.footnote.split('EN 50131-1');

// ---------- Geometry: viewBox 0 0 1200 860, y grows downward ----------
// Levels: ground 700, ground floor 690, first floor 540, ceilings 556 / 400.

// Stair: 13 risers from the hall floor (542, 690) up to the landing (380, 540).
const RISE = 150 / 13;
const GO = 162 / 12;
let stair = 'M542 690';
{
  let x = 542;
  let y = 690;
  for (let i = 0; i < 13; i++) {
    y -= RISE;
    stair += `V${f(y)}`;
    if (i < 12) {
      x -= GO;
      stair += `H${f(x)}`;
    }
  }
}
const pitch = RISE / GO;
const railY = (x: number) => 634.5 - (542 - x) * pitch;
const treadY = (x: number) => 690 - RISE * (Math.floor((542 - x) / GO) + 1);
const stairBits =
  `M380 564L527 690M543 ${f(railY(543))}L380 ${f(railY(380))}M540 690V630H546V690M374 540V494H380V540` +
  [530, 508, 486, 464, 442, 420, 398].map((x) => `M${x} ${f(railY(x))}V${f(treadY(x))}`).join('');

// Cut timber joists in the first floor, insulation loops in the loft.
const joists = [180, 204, 228, 252, 276, 300, 324, 348, 372, 532, 556, 580, 604]
  .map((x) => `M${x} 542h4v12h-4z`)
  .join('');
const insulation = Array.from({ length: 37 }, (_, i) => `M${174 + i * 12} 392a6 6 0 0 1 12 0`).join('');

// Slates hinted along both roof slopes.
function slates(ax: number, ay: number, bx: number, by: number, nx: number, ny: number, down: number) {
  const L = Math.hypot(bx - ax, by - ay);
  const ux = (bx - ax) / L;
  const uy = (by - ay) / L;
  let d = '';
  for (let t = 10; t < L - 8; t += 11) {
    d += `M${f(ax + ux * t)} ${f(ay + uy * t)}l${f(nx * 9 + down * ux * 3)} ${f(ny * 9 + down * uy * 3)}`;
  }
  return d;
}
const slateTicks = slates(118, 399, 400, 179, 0.615, 0.788, -1) + slates(400, 179, 682, 399, -0.615, 0.788, 1);

// Block paving in section, the sub-base below it.
const paving = Array.from({ length: 18 }, (_, i) => `M${660 + i * 18} 700v7`).join('') + 'M652 707H978';

// Back garden: a boarded fence beyond, a tree in front of it.
const fence = Array.from({ length: 18 }, (_, i) => `M${6 + i * 8} 642V700`).join('') + 'M0 642H148M0 670H148';
const canopy = (() => {
  const cx = 88;
  const cy = 560;
  const n = 11;
  const pts = Array.from({ length: n }, (_, i) => {
    const a = -Math.PI / 2 + (i / n) * Math.PI * 2;
    const r = 44 + (i % 3 === 0 ? 5 : i % 2 ? -2 : 2);
    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
  });
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 1; i <= n; i++) {
    const [x, y] = pts[i % n];
    const [px, py] = pts[i - 1];
    const r = f(Math.hypot(x - px, y - py) * 0.62);
    d += `A${r} ${r} 0 0 1 ${f(x)} ${f(y)}`;
  }
  return `${d}ZM88 700C88 668 86 640 89 604M88 646L73 628M88 632L103 612`;
})();

// PIR detection fan: six lobes, from nearly flat to nearly straight down.
const PIR = { x: 616, y: 574, r: 250 };
const wedge = (a1: number, a2: number) => {
  const p = (a: number) =>
    `${f(PIR.x + PIR.r * Math.cos((a * Math.PI) / 180))} ${f(PIR.y + PIR.r * Math.sin((a * Math.PI) / 180))}`;
  return `M${PIR.x} ${PIR.y}L${p(a1)}A${PIR.r} ${PIR.r} 0 0 1 ${p(a2)}Z`;
};
const lobes = [
  [165, 174],
  [152, 161],
  [139, 148],
  [126, 135],
  [113, 122],
  [100, 109],
].map(([a, b]) => wedge(a, b));
const fanFill = wedge(100, 174);

// CCTV inset: the camera's own view of the driveway, in perspective.
const insetLines = (() => {
  const T = [934, 1036];
  const B = [810, 1160];
  let d = '';
  for (let k = 1; k < 6; k++) {
    d += `M${f(T[0] + ((T[1] - T[0]) * k) / 6)} 186L${f(B[0] + ((B[1] - B[0]) * k) / 6)} 284`;
  }
  for (const y of [193, 202, 214, 229, 248, 271]) {
    const t = (y - 186) / 98;
    d += `M${f(T[0] + (B[0] - T[0]) * t)} ${y}H${f(T[1] + (B[1] - T[1]) * t)}`;
  }
  return d;
})();
---

<section id="how-it-works" class="section is-night anatomy" aria-labelledby="anatomy-title" data-anatomy>
  <div class="container an-head">
    <h2 id="anatomy-title" class="h-section">{anatomy.title}</h2>
    <p class="lede">{anatomy.lede}</p>
  </div>

  <div class="an-stage" data-an-stage>
    <div class="container an-grid">
      <ol class="an-steps" role="list">
        {
          steps.map((s, i) => (
            <li class="an-step" id={`how-${s.id}`} data-an-step={i}>
              <span class="an-step__led" aria-hidden="true" />
              {i < steps.length - 1 && <span class="an-step__rail" aria-hidden="true" />}
              <h3 class="an-step__title">{s.title}</h3>
              <p class="an-step__zone data">{s.zone}</p>
              <div class="an-step__body">
                <div>
                  <p>{s.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <figure class="an-figure">
        <div class="an-art" data-an-art>
          <svg class="an-svg" viewBox="0 0 1200 860" role="img" aria-label={anatomyArt.label} focusable="false">
            <defs>
              <pattern id="an-p-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <rect class="pf-700" width="6" height="6" />
                <path class="pl-600" d="M0 0V6" />
              </pattern>
              <pattern id="an-p-conc" width="12" height="12" patternUnits="userSpaceOnUse">
                <rect class="pf-700" width="12" height="12" />
                <path class="pl-dot" d="M2.5 3h.01M8 8.5h.01M6.5 2h.01M10.5 4.5l-1.6 1.4M3 9.5l1.8.6" />
              </pattern>
              <pattern id="an-p-earth" width="16" height="16" patternUnits="userSpaceOnUse">
                <rect class="pf-850" width="16" height="16" />
                <path class="pl-700" d="M3 4l2 2M11 11l2-2M10 3h.01M4 12h.01" />
              </pattern>
              <pattern id="an-p-sub" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
                <rect class="pf-800" width="5" height="5" />
                <path class="pl-700" d="M0 0V5" />
              </pattern>
              <pattern id="an-p-scan" width="4" height="3" patternUnits="userSpaceOnUse">
                <rect width="4" height="1" fill="#fff" fill-opacity="0.05" />
              </pattern>

              <radialGradient id="an-g-sodium">
                <stop offset="0" class="s-sodium" stop-opacity="0.5" />
                <stop offset="1" class="s-sodium" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="an-g-amber">
                <stop offset="0" class="s-sodium" stop-opacity="0.9" />
                <stop offset="1" class="s-sodium" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="an-g-blue">
                <stop offset="0" class="s-blue" stop-opacity="0.95" />
                <stop offset="0.3" class="s-blue" stop-opacity="0.35" />
                <stop offset="1" class="s-blue" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="an-g-red">
                <stop offset="0" class="s-red" stop-opacity="0.9" />
                <stop offset="1" class="s-red" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="an-g-white">
                <stop offset="0" class="s-flood" stop-opacity="0.85" />
                <stop offset="1" class="s-flood" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="an-g-vig" r="0.75">
                <stop offset="0.5" class="s-black" stop-opacity="0" />
                <stop offset="1" class="s-black" stop-opacity="0.65" />
              </radialGradient>
              <linearGradient id="an-g-street" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" class="s-sodium" stop-opacity="0.17" />
                <stop offset="1" class="s-sodium" stop-opacity="0.03" />
              </linearGradient>
              <linearGradient id="an-g-beam" gradientUnits="userSpaceOnUse" x1="677" y1="546" x2="1054" y2="546">
                <stop offset="0" class="s-flood" stop-opacity="0.55" />
                <stop offset="0.55" class="s-flood" stop-opacity="0.12" />
                <stop offset="1" class="s-flood" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="an-g-cone" gradientUnits="userSpaceOnUse" x1="706" y1="487" x2="1186" y2="487">
                <stop offset="0" class="s-flood" stop-opacity="0.16" />
                <stop offset="1" class="s-flood" stop-opacity="0.02" />
              </linearGradient>
              <linearGradient id="an-g-door" x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" class="s-sodium" stop-opacity="0.55" />
                <stop offset="1" class="s-sodium" stop-opacity="0.2" />
              </linearGradient>
              <linearGradient id="an-g-spill" gradientUnits="userSpaceOnUse" x1="560" y1="640" x2="440" y2="690">
                <stop offset="0" class="s-sodium" stop-opacity="0.34" />
                <stop offset="1" class="s-sodium" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="an-g-isky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0a1013" />
                <stop offset="1" stop-color="#1b2428" />
              </linearGradient>
              <linearGradient id="an-g-fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0.25" class="s-white" />
                <stop offset="1" class="s-black" />
              </linearGradient>
              <mask id="an-m-ground" maskUnits="userSpaceOnUse" x="0" y="690" width="1200" height="120">
                <rect x="0" y="690" width="1200" height="120" fill="url(#an-g-fade)" />
              </mask>
              <clipPath id="an-c-out"><rect x="650" y="0" width="560" height="700" /></clipPath>
              <clipPath id="an-c-hall"><rect x="380" y="556" width="248" height="134" /></clipPath>
              <clipPath id="an-c-f1"><rect x="172" y="400" width="456" height="140" /></clipPath>
              <clipPath id="an-c-pool"><rect x="700" y="696" width="276" height="14" /></clipPath>
              <clipPath id="an-c-inset"><rect x="810" y="60" width="350" height="224" rx="8" /></clipPath>
            </defs>

            <!-- Sheet: registration marks and title block -->
            <path class="l3 d1" d="M8 24V8H24M1176 8H1192V24M8 836V852H24M1192 836V852H1176" {...ns} />
            <g class="an-sheet" data-an-sheet>
              <text class="an-sheet__t" x="24" y="26">{up(anatomyArt.sheetTitle)}</text>
              <text class="an-sheet__n" x="24" y="26" dy="2.7em">{up(anatomyArt.sheetNote)}</text>
            </g>

            <!-- Street lighting falls on the footpath before anything else is drawn -->
            <g data-an-glow>
              <path d="M1002 361L1021 361L1114 704L910 704Z" fill="url(#an-g-street)" />
              <ellipse cx="1012" cy="699" rx="112" ry="6" fill="url(#an-g-sodium)" />
              <circle cx="1012" cy="362" r="74" fill="url(#an-g-sodium)" />
            </g>

            <!-- Ground -->
            <path class="an-earth" d="M0 700H1200V810H0Z" mask="url(#an-m-ground)" data-fill />
            <path class="an-sub" d="M650 707H978V722H650Z" data-fill />
            <path class="an-kerb" d="M990 695H1098V703H990Z" data-fill />
            <path class="an-tarmac" d="M1098 704H1200V718H1098Z" data-fill />

            <!-- Beyond the cut: fence, chimney, pictures, landing window -->
            <path class="l3 d5" d={fence} {...ns} />
            <path
              class="an-chimney d1"
              d="M370 202.4V140H414V189.9L400 179ZM366 134H418V140H366ZM377 134V122H387V134M397 134V124H407V134"
              {...ns}
              data-fill
            />
            <path class="l3 d4" d="M317 392L275 294.5M317 392L400 197M483 392L400 197M483 392L525 294.5" {...ns} />
            <path class="l3 d4" d="M306 596H346V622H306ZM222 444H262V470H222Z" {...ns} />
            <rect class="an-winglow" x="430" y="432" width="48" height="68" data-fill />
            <path class="l3 d3" d="M430 432H478V500H430ZM454 432V500M430 466H478" {...ns} />

            <!-- Cut planes: walls, roof, floors, partitions -->
            <path
              class="an-poche d1"
              d="M150 400H172V430H150ZM150 490H172V588H150ZM150 640H172V745H184V760H138V745H150Z"
              {...ns}
              data-fill
            />
            <path
              class="an-poche d1"
              d="M628 400H650V430H628ZM628 490H650V588H628ZM628 640H650V745H662V760H616V745H628Z"
              {...ns}
              data-fill
            />
            <path class="an-cavity" d="M161 400V430M161 490V588M161 640V745M639 400V430M639 490V588M639 640V745" data-fill />
            <path class="an-roof d1" d="M118 399L400 179L682 399V417L400 197L118 417Z" {...ns} data-fill />
            <path class="an-slab d2" d="M150 392H650V400H150Z" {...ns} data-fill />
            <path class="an-slab d2" d="M172 540H380V556H172ZM520 540H628V556H520Z" {...ns} data-fill />
            <path class="an-joist" d={joists} data-fill />
            <path class="an-conc d2" d="M172 690H628V706H172Z" {...ns} data-fill />
            <path class="an-part d3" d="M374 556H380V690H374ZM318 400H324V540H318ZM520 400H526V540H520Z" {...ns} data-fill />

            <!-- Line work -->
            <path class="l2 d1" d={slateTicks} {...ns} />
            <path
              class="l1 d1"
              d="M112 399H118V423H112ZM682 399H688V423H682ZM118 423H150M650 423H682M112 419A7 7 0 0 1 98 419M688 419A7 7 0 0 0 702 419M393 181A7 7 0 0 1 407 181"
              {...ns}
            />
            <path class="l2 d2" d={insulation} {...ns} />
            <path
              class="l2 d3"
              d="M159 430V490M163 430V490M159 588V640M163 588V640M144 492H150M144 642H150M650 492H656M650 642H656"
              {...ns}
            />
            <path class="an-litglass d3" d="M637 430V490M641 430V490M637 588V640M641 588V640" {...ns} />
            <path class="l1 d3" d={stair} {...ns} />
            <path class="l2 d3" d={stairBits} {...ns} />

            <!-- Front door, seen beyond in the hall. The contact sits on the frame. -->
            <rect x="560" y="578" width="50" height="112" fill="url(#an-g-door)" />
            <path class="l2 d3" d="M556 690V574H614V690" {...ns} />
            <g data-an-leaf data-an-fade>
              <path class="an-leaf" d="M560 578H610V690H560Z" {...ns} />
              <path class="an-leafglass" d="M566 586H582V620H566ZM588 586H604V620H588Z" />
              <path class="l2" d="M566 632H582V682H566ZM588 632H604V682H588ZM578 624H592V628H578Z" {...ns} />
              <circle class="an-knob" cx="604" cy="628" r="1.8" />
              <rect class="an-dev" x="598" y="579.5" width="9" height="4" rx="1" data-dev="0" />
            </g>

            <!-- Furniture hints -->
            <path
              class="l2 d4"
              d="M176 690V642H262V690M174 638H264V642H174ZM205 646V684M234 646V684M176 684H262M176 574H262V612H176ZM205 574V612M234 574V612"
              {...ns}
            />
            <path
              class="l2 d4"
              d="M290 682V656Q290 650 296 650H302Q306 650 306 656V664H338V636Q338 630 344 630H350Q356 630 356 636V682ZM296 682V690M350 682V690M268 690H280M274 690V606M266 606H282L279 594H269Z"
              {...ns}
            />
            <path
              class="l2 d4"
              d="M178 540V486H186V540M186 506H286Q292 506 292 512V526H186M192 526V540M288 526V540M190 506Q190 496 200 496H206Q212 496 212 506M218 506Q250 499 286 506M614 540V494H622V540M614 510H538Q532 510 532 516V526H614M536 526V540M610 526V540M610 510Q610 500 600 500H596Q590 500 590 510"
              {...ns}
            />

            <!-- Site: garden, driveway, footpath, road, streetlight -->
            <path class="l1 d5" d="M0 700H150M650 700H990V695H1098V704H1200" {...ns} />
            <path class="l2 d5" d={paving} {...ns} />
            <path class="l2 d5" d="M978 700V668H990V700M975 668H993V663H975Z" {...ns} />
            <path class="l2 d5" d={canopy} {...ns} />
            <path class="l2 d5" d="M1062 695V384M1057 695H1067M1062 384C1062 362 1042 352 1022 353M1000 352H1024L1021 359H1003Z" {...ns} />
            <ellipse class="an-lamp" cx="1012" cy="360" rx="9" ry="1.8" data-an-glow />

            <!-- Device light: floodlight beam, camera view cone, PIR fan, smoke rings, door spill -->
            <circle class="an-bell-glow" cx="656" cy="425" r="46" fill="url(#an-g-blue)" data-an-blue data-dev="4" />
            <g clip-path="url(#an-c-out)">
              <g transform="rotate(40 658 546)">
                <path class="an-beam" d="M677 537L1054 362L1054 730L677 555Z" data-an-fx="4" />
              </g>
              <ellipse class="an-pool" cx="842" cy="700" rx="150" ry="7" fill="url(#an-g-white)" data-an-fx="4" />
              <path class="an-pavelit" d={paving} clip-path="url(#an-c-pool)" {...ns} data-an-fx="4" />
              <g transform="rotate(44 668 487)">
                <g data-an-cam>
                  <g class="an-cone" data-an-fx="2">
                    <path d="M706 487L1186 358.4L1186 615.6Z" fill="url(#an-g-cone)" />
                    <path class="an-cone__edge" d="M706 487L1186 358.4M706 487L1186 615.6" {...ns} />
                  </g>
                </g>
              </g>
            </g>
            <g clip-path="url(#an-c-hall)">
              <path class="an-fanfill" d={fanFill} data-an-fanfill />
              {lobes.map((d) => <path class="an-lobe" d={d} {...ns} data-an-fx="1" />)}
              <path class="an-sweep" d="M616 574H876" {...ns} data-an-sweep />
            </g>
            <g clip-path="url(#an-c-f1)">
              <circle class="an-smokeglow" cx="352" cy="407" r="78" fill="url(#an-g-red)" data-an-smokeglow />
