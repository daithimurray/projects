      <span>{footA}<span class="data an-footnote__std">EN 50131-1</span>{footB}</span>
    </p>
  </div>
</section>

<style>
  .anatomy {
    --u: 1.4;
    --an-pad: 0.95rem;
    --an-door: #1c4a47;
    overflow-x: clip;
  }

  /* ---------- Heading ---------- */
  .an-head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(var(--space-7), 1rem + 5vw, var(--space-9));
  }
  .an-head .lede {
    max-width: 42ch;
  }
  @media (min-width: 1000px) {
    .an-head {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--space-8);
    }
  }

  /* ---------- Layout: static, no-JS and reduced motion ---------- */
  .an-grid {
    display: grid;
    gap: var(--space-7);
  }
  .an-figure {
    margin: 0;
  }
  .an-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1200 / 860;
  }
  .an-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  @media (min-width: 1000px) {
    .an-grid {
      grid-template-columns: minmax(18rem, 25rem) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 4vw, 4.5rem);
      align-items: start;
    }
    .an-figure {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
  @media (max-width: 999.98px) {
    .an-figure {
      order: -1;
    }
  }

  /* ---------- Steps ---------- */
  .an-steps {
    display: grid;
  }
  .an-step {
    --led-top: calc(var(--an-pad) + var(--step-1) * 0.58 - 5px);
    position: relative;
    padding: var(--an-pad) 0 var(--an-pad) 2.25rem;
  }
  .an-step + .an-step {
    border-top: 1px solid var(--night-800);
  }
  /* A panel LED per zone. Static page: every zone armed. */
  .an-step__led {
    position: absolute;
    left: 0;
    top: var(--led-top);
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--sodium-500);
    box-shadow: 0 0 10px 1px var(--sodium-glow);
  }
  .an-step__rail {
    display: none;
  }
  .an-step__title {
    font-size: var(--step-1);
    font-stretch: 112%;
    font-weight: 720;
    letter-spacing: -0.012em;
    line-height: var(--leading-snug);
    color: var(--dusk-50);
  }
  .an-step__zone {
    margin-top: 0.35rem;
    color: var(--dusk-300);
  }
  .an-step__body p {
    padding-top: 0.65rem;
    max-width: 40ch;
    color: var(--dusk-200);
  }

  /* ---------- Live (JS + motion): steps light as their zone switches on ---------- */
  .anatomy.is-live .an-step__led {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--night-500);
    transition:
      background-color 1.3s var(--ease-out),
      box-shadow 1.3s var(--ease-out),
      opacity 1.3s var(--ease-out);
  }
  .anatomy.is-live .an-step.is-done .an-step__led {
    background: var(--sodium-600);
    box-shadow: inset 0 0 0 1px var(--sodium-600);
    opacity: 0.6;
  }
  .anatomy.is-live .an-step.is-active .an-step__led {
    background: var(--sodium-500);
    box-shadow: 0 0 14px 3px var(--sodium-glow);
    opacity: 1;
    transition-duration: 120ms;
  }
  .anatomy.is-live .an-step__title {
    color: var(--dusk-400);
    transition: color 0.7s var(--ease-out);
  }
  .anatomy.is-live .an-step.is-done .an-step__title {
    color: var(--dusk-300);
  }
  .anatomy.is-live .an-step.is-active .an-step__title {
    color: var(--dusk-50);
    animation: an-trip 0.55s linear;
  }
  .anatomy.is-live .an-step__zone {
    color: var(--dusk-400);
    transition: color 0.7s var(--ease-out);
  }
  .anatomy.is-live .an-step.is-active .an-step__zone {
    color: var(--sodium-500);
    transition-duration: 120ms;
  }
  .anatomy.is-live .an-step__body p {
    color: var(--dusk-300);
    transition: color 0.6s var(--ease-out);
  }
  .anatomy.is-live .an-step.is-active .an-step__body p {
    color: var(--dusk-200);
  }
  @keyframes an-trip {
    0% { color: var(--dusk-400); }
    9% { color: var(--dusk-50); }
    16% { color: var(--dusk-300); }
    30%, 100% { color: var(--dusk-50); }
  }

  /* Pinned desktop: the list is a zone panel. Only the live zone opens. */
  .anatomy.is-pinned .an-stage {
    height: 100vh;
    height: 100svh;
    display: grid;
    align-items: center;
  }
  .anatomy.is-pinned .an-figure {
    position: relative;
    top: auto;
  }
  .anatomy.is-pinned .an-art {
    width: min(100%, calc((100svh - 8.5rem) * 1200 / 860));
    margin-left: auto;
  }
  .anatomy.is-pinned .an-step {
    border-top: 0;
  }
  /* The drawing sets the stage height, so opening a longer step never shifts the stage. */
  .anatomy.is-pinned .an-steps {
    height: 0;
    overflow: visible;
  }
  @media (max-height: 780px) {
    .anatomy.is-pinned {
      --an-pad: 0.6rem;
    }
  }
  .anatomy.is-pinned .an-step__rail {
    display: block;
    position: absolute;
    left: 4.5px;
    width: 1px;
    top: calc(var(--led-top) + 16px);
    bottom: calc(6px - var(--led-top));
    background: var(--night-700);
  }
  .anatomy.is-pinned .an-step__rail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--sodium-500);
    box-shadow: 0 0 6px var(--sodium-glow);
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
  }
  .anatomy.is-pinned .an-step__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }
  .anatomy.is-pinned .an-step__body > div {
    min-height: 0;
    overflow: hidden;
  }
  .anatomy.is-pinned .an-step.is-active .an-step__body {
    grid-template-rows: 1fr;
    transition-duration: 0.65s;
  }
  .anatomy.is-pinned .an-step__body p {
    opacity: 0;
    transition: opacity 0.25s linear;
  }
  .anatomy.is-pinned .an-step.is-active .an-step__body p {
    opacity: 1;
    transition: opacity 0.7s var(--ease-out) 0.15s;
  }

  /* Step buttons exist only while pinned (created by anatomy.js). */
  .an-step :global(.an-step__btn) {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .an-step :global(.an-step__btn)::after {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .an-step :global(.an-step__btn:hover)::after {
    background: rgb(159 176 207 / 0.05);
  }
  .an-step :global(.an-step__btn:focus-visible) {
    outline: none;
  }
  .an-step :global(.an-step__btn:focus-visible)::after {
    outline: 2px solid var(--sodium-400);
    outline-offset: 0;
  }
  .anatomy.is-pinned .an-step:not(.is-active):hover .an-step__title {
    color: var(--dusk-200);
  }
  .anatomy.is-pinned .an-step:not(.is-active):hover .an-step__led {
    box-shadow: inset 0 0 0 1px var(--sodium-500);
    transition-duration: 120ms;
  }
  .an-step :global(.an-step__btn:active) {
    transform: translateY(1px);
  }

  /* Mobile with motion: the drawing stays at the top while the zones pass under it. */
  .anatomy.is-sticky .an-figure {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-3) var(--gutter) var(--space-4);
    background: var(--night-900);
  }
  .anatomy.is-sticky .an-figure::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 2.5rem;
    background: linear-gradient(var(--night-900), rgb(12 22 40 / 0));
    pointer-events: none;
  }
  .anatomy.is-sticky .an-art {
    max-width: calc(40svh * 1200 / 860);
    margin-inline: auto;
    overflow: clip;
    border-radius: var(--radius-sm);
  }
  /* Scroll room sits above each step's text, so the live step is always below the drawing. */
  .anatomy.is-sticky .an-step {
    --an-pad: 22svh;
    padding-bottom: var(--space-3);
    border-top: 0;
  }
  .anatomy.is-sticky .an-step:first-child {
    --an-pad: var(--space-6);
  }
  /* In the close-up crops only the live zone is labelled; the list names the rest. */
  .anatomy.is-sticky .an-tag[data-state='calm'] .an-tag__txt,
  .anatomy.is-sticky .an-sheet {
    visibility: hidden;
  }

  /* ---------- Footnote ---------- */
  .an-foot {
    margin-top: clamp(var(--space-7), 2rem + 3vw, var(--space-9));
  }
  .an-footnote {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 62ch;
    padding-top: var(--space-5);
    border-top: 1px solid var(--night-700);
    color: var(--dusk-200);
  }
  .an-footnote :global(.icon) {
    flex: none;
    color: var(--sodium-500);
  }
  .an-footnote__std {
    font-size: 0.86em;
    color: var(--dusk-50);
    text-transform: none;
  }

  /* ---------- The drawing ---------- */
  .an-svg text {
    font-family: var(--font-data);
    font-stretch: 88%;
    font-weight: 500;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .l1,
  .l2,
  .l3 {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .l1 {
    stroke: var(--dusk-300);
    stroke-width: 1.3;
  }
  .l2 {
    stroke: var(--dusk-400);
    stroke-width: 1;
  }
  .l3 {
    stroke: var(--night-500);
    stroke-width: 1;
  }
  .pf-700 { fill: var(--night-700); }
  .pf-800 { fill: var(--night-800); }
  .pf-850 { fill: var(--night-850); }
  .pl-600 { stroke: var(--night-600); stroke-width: 1.1; }
  .pl-700 { stroke: var(--night-700); stroke-width: 1.2; stroke-linecap: round; }
  .pl-dot { stroke: var(--night-500); stroke-width: 1.5; stroke-linecap: round; }
  .s-sodium { stop-color: var(--sodium-500); }
  .s-blue { stop-color: var(--strobe-500); }
  .s-red { stop-color: var(--alarm-500); }
  .s-flood { stop-color: var(--flood-50); }
  .s-white { stop-color: #fff; }
  .s-black { stop-color: #000; }

  .an-poche {
    fill: url(#an-p-hatch);
    stroke: var(--dusk-300);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .an-cavity {
    fill: none;
    stroke: var(--night-900);
    stroke-width: 1.6;
  }
  .an-roof {
    fill: var(--slate);
    stroke: var(--dusk-300);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .an-slab {
    fill: var(--night-800);
    stroke: var(--dusk-300);
    stroke-width: 1.1;
  }
  .an-conc {
    fill: url(#an-p-conc);
    stroke: var(--dusk-300);
    stroke-width: 1.2;
  }
  .an-joist { fill: var(--night-600); }
  .an-part {
    fill: var(--night-700);
    stroke: var(--dusk-400);
    stroke-width: 1;
  }
  .an-chimney {
    fill: var(--night-850);
    stroke: var(--night-500);
    stroke-width: 1;
  }
  .an-earth { fill: url(#an-p-earth); }
  .an-sub { fill: url(#an-p-sub); }
  .an-kerb { fill: var(--night-800); }
  .an-tarmac { fill: var(--tarmac); }
  .an-winglow { fill: var(--sodium-500); fill-opacity: 0.06; }
  .an-litglass {
    fill: none;
    stroke: var(--sodium-600);
    stroke-opacity: 0.7;
    stroke-width: 1;
  }
  .an-leaf {
    fill: var(--an-door);
    stroke: var(--dusk-400);
    stroke-width: 1;
  }
  .an-leafglass {
    fill: var(--sodium-500);
    fill-opacity: 0.2;
  }
  .an-knob { fill: var(--dusk-300); }
  .an-lamp { fill: var(--sodium-300); }

  /* Devices: brighter than the house, so they read as fitted items */
  .an-dev {
    fill: var(--night-800);
    stroke: var(--dusk-200);
    stroke-width: 1.2;
    stroke-linejoin: round;
    transition: stroke 1s var(--ease-out);
  }
  .an-dev[data-state='off'] { stroke: var(--dusk-400); }
  .an-dev[data-state='on'] {
    stroke: var(--dusk-50);
    transition-duration: 120ms;
  }
  .an-dev-ln {
    fill: none;
    stroke: var(--dusk-300);
    stroke-width: 1;
  }
  .an-lens {
    fill: var(--night-950);
    stroke: var(--dusk-200);
    stroke-width: 1;
  }

  /* LEDs trip on fast and decay slowly: the transition takes the target state's duration */
  .an-led {
    fill: var(--night-600);
    transition: fill 1.3s var(--ease-out);
  }
  .an-led[data-state='calm'] { fill: var(--sodium-500); }
  .an-led[data-state='on'] {
    fill: var(--sodium-300);
    transition-duration: 100ms;
    animation: an-blink 0.8s steps(1, end) 2;
  }
  .an-led--red[data-state='calm'] { fill: var(--alarm-500); }
  .an-led--red[data-state='on'] { fill: var(--alarm-500); }
  .an-bloom {
    opacity: 0.4;
    transition: opacity 1.4s var(--ease-out);
  }
  .an-bloom[data-state='off'] { opacity: 0; }
  .an-bloom[data-state='on'] {
    opacity: 1;
    transition-duration: 110ms;
  }
  @keyframes an-blink {
    0%, 50% { fill-opacity: 1; }
    25%, 75% { fill-opacity: 0.2; }
  }
  .an-bell-lens {
    fill: var(--strobe-500);
    stroke: var(--dusk-200);
    stroke-width: 0.8;
    transition: fill 1s var(--ease-out);
  }
  .an-bell-lens[data-state='off'] { fill: var(--night-600); }
  .an-bell-lens[data-state='on'] { fill: var(--strobe-400); transition-duration: 100ms; }
  .an-flood-face {
    fill: none;
    stroke: var(--flood-50);
    stroke-width: 1.8;
    transition: stroke 1s var(--ease-out);
  }
  .an-flood-face[data-state='off'] { stroke: var(--dusk-400); }

  /* Device light, in its calm (armed) state. JS reads these as the resting values. */
  .an-bell-glow { opacity: 0.25; }
  .an-beam { fill: url(#an-g-beam); opacity: 0.4; }
  .an-pool { opacity: 0.4; }
  .an-pavelit {
