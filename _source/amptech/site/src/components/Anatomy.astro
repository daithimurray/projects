                <rect x="810" y="60" width="350" height="224" fill="url(#an-p-scan)" />
                <rect x="810" y="60" width="350" height="224" fill="url(#an-g-vig)" />
                <rect class="an-i-flash" x="810" y="60" width="350" height="224" data-an-flash />
