            </g>
            <g class="an-spill" data-an-fx="0">
              <path d="M560 580L560 690L440 690Z" fill="url(#an-g-spill)" />
              <ellipse cx="562" cy="690" rx="66" ry="5" fill="url(#an-g-sodium)" />
            </g>

            <!-- Devices. data-state: off, on (its step is active) or calm (armed) -->
            <g class="an-devices" data-an-devices>
              <!-- Z1: contacts on the front door frame and the kitchen window -->
              <rect class="an-dev" x="597" y="572.5" width="11" height="4.5" rx="1" data-dev="0" data-state="calm" />
              <rect class="an-dev" x="163" y="582" width="9" height="4.5" rx="1" data-dev="0" data-state="calm" />
              <circle class="an-bloom" cx="602.5" cy="574.8" r="10" fill="url(#an-g-amber)" data-dev="0" data-state="calm" />
              <circle class="an-bloom" cx="167.5" cy="584.2" r="9" fill="url(#an-g-amber)" data-dev="0" data-state="calm" />
              <circle class="an-led" cx="602.5" cy="574.8" r="1.3" data-dev="0" data-state="calm" />
              <circle class="an-led" cx="167.5" cy="584.2" r="1.2" data-dev="0" data-state="calm" />

              <!-- Z2: PIR high in the hall corner -->
              <path class="an-dev" d="M627 558H619Q615 558 615 562V570Q615 575 620 577L627 580Z" data-dev="1" data-state="calm" />
              <path class="an-dev-ln" d="M616.5 571Q618.5 576 624 577.8" {...ns} />
              <circle class="an-bloom" cx="619.5" cy="563.5" r="10" fill="url(#an-g-amber)" data-dev="1" data-state="calm" />
              <circle class="an-led" cx="619.5" cy="563.5" r="1.3" data-dev="1" data-state="calm" />

              <!-- Cam 1: bracket on the front wall, head pans -->
              <path class="an-dev" d="M650 481H659V493H650ZM659 487H668" data-dev="2" data-state="calm" />
              <g transform="rotate(44 668 487)">
                <g data-an-cam>
                  <path class="an-dev" d="M668 481H700Q704 481 704 485V489Q704 493 700 493H668Z" data-dev="2" data-state="calm" />
                  <path class="an-dev" d="M664 477.5H707L703 481" data-dev="2" data-state="calm" />
                  <circle class="an-lens" cx="704" cy="487" r="3.2" />
                </g>
              </g>

              <!-- Z5: smoke detector on the landing ceiling -->
              <path class="an-dev" d="M341 400H363V402.5Q363 407 358.5 407H345.5Q341 407 341 402.5Z" data-dev="3" data-state="calm" />
              <circle class="an-bloom" cx="352" cy="404" r="10" fill="url(#an-g-red)" data-dev="3" data-state="calm" />
              <circle class="an-led an-led--red" cx="352" cy="404" r="1.2" data-dev="3" data-state="calm" />

              <!-- External: bell box high under the eaves, floodlight over the driveway -->
              <path class="an-dev" d="M650 428H658Q662 428 662 432V460Q662 464 658 464H650Z" data-dev="4" data-state="calm" />
