              <rect class="an-i-frame" x="810" y="60" width="350" height="224" rx="8" {...ns} />
              <text class="an-osd" x="824" y="74">{up(steps[2].zone)}</text>
              <text class="an-osd" x="1146" y="74" text-anchor="end" data-an-clock>{anatomyArt.camTime}</text>
              <circle class="an-rec" cx="828" cy="266" r="3.5" data-an-rec />
              <text class="an-osd an-osd--mid" x="838" y="266">{up(anatomyArt.rec)}</text>
            </g>
          </svg>

          <div class="an-phone" data-dev="5" data-state="calm" data-an-phone aria-hidden="true">
            <div class="an-phone__screen">
