---
// Services: a lit, ruled index, like an alarm panel's zone list, in two groups
// ("New systems", "Looking after them") that use the client's own service names.
// Left: heading, lede, then a floodlight-on-a-wall vignette with the phone CTA.
// On wide screens the vignette and CTA stay beside the list while it scrolls
// (the heading scrolls away, so the stuck block always fits a laptop screen).
// Each row "trips" as it scrolls in and lights up under the pointer or keyboard
// focus, where its drawn glyph plays its own small movement. Hovering a row
// also re-trips the lamp.
import Icon from './Icon.astro';
import { company, hero, services, servicesUi } from '../data/content.js';

// Service glyphs: 24px grid, 1.6 stroke, round caps (same grammar as Icon.astro).
// Local because each carries class hooks for its own micro-animation.
const glyphs: Record<string, string> = {
  // PIR detector: its detection fan pulses outward
  intruder:
    '<path d="M8 3.5h8a1.5 1.5 0 0 1 1.5 1.5v3.4a5.5 5.5 0 0 1-11 0V5A1.5 1.5 0 0 1 8 3.5Z"/><circle cx="12" cy="8.6" r="1.6"/>' +
    '<path class="g-lit g-fan g-fan-1" d="M8.4 16.4q3.6 2 7.2 0"/><path class="g-lit g-fan g-fan-2" d="M6 19.3q6 3.3 12 0"/>',
  // Bullet camera on a wall bracket: the head pans
  cctv:
    '<path d="M3.5 14.2v6"/><path d="M3.5 17.2h4.6a1.4 1.4 0 0 0 1.4-1.4v-3.1"/>' +
    '<g class="g-head"><path d="M4.4 5.3h15"/><rect x="5.5" y="7.2" width="12" height="5.5" rx="1.6"/><path class="g-lit" d="M17.5 8.4h2.4v3.1h-2.4"/></g>',
  // Ceiling smoke detector: smoke rises to it, its LED blinks
  fire:
    '<path d="M3.5 3.5h17"/><path d="M6.5 3.5v2.3a2.2 2.2 0 0 0 2.2 2.2h6.6a2.2 2.2 0 0 0 2.2-2.2V3.5"/><path d="M9 5.7h3.5"/>' +
    '<circle class="g-led" cx="15.2" cy="5.7" r=".95" fill="currentColor" stroke="none"/>' +
    '<path class="g-smoke g-smoke-1" d="M10 21.2c-1.3-1.2 1.3-2.3 0-3.6s1.3-2.3 0-3.6"/><path class="g-smoke g-smoke-2" d="M14.4 20.4c-1.2-1.1 1.2-2.1 0-3.3s1.2-2.1 0-3.3"/>',
  // Floodlight on a wall plate: the beam extends
  lighting:
    '<path d="M3.5 4.6v7"/><path d="M3.5 8.1h2.2"/><path d="M6.1 5.2 13 7.6l-1.6 4.8-6.6-2.4Z"/>' +
    '<path class="g-lit g-beam" pathLength="1" d="M14.3 8.8 20.6 11"/><path class="g-lit g-beam" pathLength="1" d="m13.5 11.8 5.3 4.8"/><path class="g-lit g-beam" pathLength="1" d="m12.2 14 3 5.8"/>',
  // Door and a fob reader: the reader goes green, then the door swings open
  access:
    '<path d="M2 20.5h20"/><path d="M3.3 20.5V3.8h11.8v16.7"/>' +
    '<g class="g-leaf"><path d="M5.9 20.5V6.4h6.6v14.1"/><path d="M10.7 12.6v1.8"/></g>' +
    '<rect x="18" y="8.4" width="3.5" height="6.2" rx="1.1"/><path d="M19.05 12.6h1.4"/>' +
    '<circle class="g-reader" cx="19.75" cy="10.3" r=".8" stroke="none"/>',
  // Wrench: turns on the nut
  upgrades:
    '<g class="g-wrench"><path d="M14.5 4a4.5 4.5 0 0 0-4.2 6.1l-6 6a1.8 1.8 0 0 0 2.6 2.6l6-6A4.5 4.5 0 0 0 19.5 8l-2.8 2.8-2.5-.7-.7-2.5L16.3 4.8A4.5 4.5 0 0 0 14.5 4Z"/></g>',
  // The engineer's report on a clipboard: the checks tick off, then it is signed
  maintenance:
    '<path d="M8.6 4.6H6.9a1.4 1.4 0 0 0-1.4 1.4v14.1a1.4 1.4 0 0 0 1.4 1.4h10.2a1.4 1.4 0 0 0 1.4-1.4V6a1.4 1.4 0 0 0-1.4-1.4h-1.7"/>' +
    '<rect x="8.6" y="2.9" width="6.8" height="3.3" rx="1"/>' +
    '<path class="g-lit g-tick g-tick-1" pathLength="1" d="m8.3 10.4 1.3 1.3 2.3-2.5"/><path d="M13.9 10.4h2.2"/>' +
    '<path class="g-lit g-tick g-tick-2" pathLength="1" d="m8.3 14.6 1.3 1.3 2.3-2.5"/><path d="M13.9 14.6h2.2"/>' +
    '<path class="g-sign" pathLength="1" d="M8.4 18.6h7.4"/>',
  // A GSM unit on the wall: its antenna sends the signal out, arc by arc
  monitoring:
    '<rect x="4" y="12.2" width="15" height="8.3" rx="1.6"/><path d="M10.6 16.35h5"/>' +
    '<circle class="g-mled" cx="7.5" cy="16.35" r=".95" stroke="none"/><path d="M16 12.2V6.6"/>' +
    '<path class="g-lit g-sig g-sig-1" d="M17.6 4.6a2.3 2.3 0 0 1 0 3.3M14.4 4.6a2.3 2.3 0 0 0 0 3.3"/>' +
    '<path class="g-lit g-sig g-sig-2" d="M19 3.2a4.3 4.3 0 0 1 0 6.1M13 3.2a4.3 4.3 0 0 0 0 6.1"/>',
  // The call-out van: it rolls in and brakes, its headlight on
  callout:
    '<path class="g-speed" d="M.9 9.6h2M.4 12.6h2.5M1.4 15.6h1.5"/>' +
    '<g class="g-van"><path d="M6.6 17H4.5V7.7a1.2 1.2 0 0 1 1.2-1.2H15l3.3 3.9 2.2.6a1.2 1.2 0 0 1 .8 1.1V17h-1.6"/><path d="M10.2 17h5.9"/>' +
    '<path d="M15 6.5v3.9h3.3"/><circle cx="8.4" cy="17.1" r="1.8"/><circle cx="17.9" cy="17.1" r="1.8"/>' +
    '<path class="g-lit g-lamp" d="M21.3 13.3h-1.3"/></g>',
  // Phone: buzzes, and a notification lands
  app:
    '<g class="g-phone"><rect x="7" y="3" width="10" height="18" rx="2.2"/><path d="M10.5 18h3"/><path d="M9.6 7.6h4.8"/><path d="M9.6 10.6h3"/></g>' +
    '<path class="g-buzz" d="M4.2 9.6v4.8"/><path class="g-buzz" d="M19.8 9.6v4.8"/>' +
    '<circle class="g-dot" cx="16.6" cy="4.1" r="1.9" stroke="none"/>',
};

const linkLabel = (id: string) => (servicesUi.links as Record<string, string>)[id];

// A body that names the phone number gets it as a tap-to-call link.
const splitPhone = (text: string) => {
  const at = text.indexOf(company.phoneDisplay);
  return at === -1 ? null : [text.slice(0, at), text.slice(at + company.phoneDisplay.length)];
};

// Rain streaks inside the floodlight beam: one 300-unit tile, repeated to loop.
const rain = Array.from({ length: 26 }, (_, i) => {
  const x = 214 + ((i * 97) % 262);
  const y = (i * 53) % 300;
  const len = 9 + ((i * 7) % 8);
  return `M${x} ${y}l-2 ${len}`;
}).join('');
---

<section id="services" class="section services is-lit" data-lit-reveal aria-labelledby="services-title" data-services>
  <div class="container services__layout">
    <div class="services__aside">
      <div class="services__intro">
        <h2 id="services-title" class="h-section services__title">{services.title}</h2>
        <p class="lede services__lede">{services.lede}</p>
      </div>

    </div>

    <div class="svc-index">
      {
        services.groups.map((group) => (
          <div class="svc-group" data-svc-group>
            <h3 id={`svc-group-${group.id}`} class="svc-group__title" data-svc-group-title>
              {group.title}
            </h3>
            <ul class="svc-list" role="list" aria-labelledby={`svc-group-${group.id}`}>
              {group.items.map((item) => {
                const phone = splitPhone(item.body);
                return (
                  <li class={`svc svc--${item.id}`} data-svc data-pointer-light>
                    <span class="svc__icon" aria-hidden="true">
                      <svg
                        class="svc__glyph"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                        set:html={glyphs[item.id] || ''}
                      />
                    </span>
                    <h4 class="svc__name">{item.name}</h4>
                    <p class="svc__body">
                      {phone ? (
                        <Fragment>
                          {phone[0]}
                          <a href={company.phoneHref}>{company.phoneDisplay}</a>
                          {phone[1]}
                        </Fragment>
                      ) : (
                        item.body
                      )}
                    </p>
                    {item.for && (
                      <p class="svc__for">
                        <span class="visually-hidden">{servicesUi.forLabel} </span>
                        {item.for.map((tag) => (
                          <span class="svc__chip">{tag}</span>
                        ))}
                      </p>
                    )}
                    {item.href && linkLabel(item.id) && (
                      <a class="svc__link" href={item.href}>
                        <span>{linkLabel(item.id)}</span>
                        <Icon name="arrow" size={18} />
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="services__lamp">
      <div class="lamp" data-lamp>
        <svg class="lamp__svg" viewBox="0 0 480 300" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="svc-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--night-950)" />
              <stop offset=".62" style="stop-color: var(--night-800)" />
              <stop offset="1" style="stop-color: color-mix(in oklab, var(--night-700), var(--sodium-600) 24%)" />
            </linearGradient>
            <radialGradient id="svc-horizon" cx="400" cy="232" r="210" gradientUnits="userSpaceOnUse">
              <stop offset="0" style="stop-color: var(--sodium-500)" stop-opacity=".4" />
              <stop offset=".55" style="stop-color: var(--sodium-500)" stop-opacity=".08" />
              <stop offset="1" style="stop-color: var(--sodium-500)" stop-opacity="0" />
            </radialGradient>
            <pattern id="svc-pebble" width="13" height="11" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2.4" r="1" fill="#3f4656" />
              <circle cx="8.6" cy="3.6" r=".8" fill="#252b38" />
              <circle cx="4.8" cy="7.6" r=".7" fill="#3c4353" />
              <circle cx="11.2" cy="9.2" r=".9" fill="#272d3a" />
              <circle cx="10.4" cy="0.8" r=".5" fill="#454c5b" />
            </pattern>
            <filter id="svc-soft" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="3.5" />
            </filter>
            <radialGradient id="svc-street" cx=".5" cy=".5" r=".5">
              <stop offset="0" style="stop-color: var(--sodium-400)" stop-opacity=".55" />
              <stop offset=".35" style="stop-color: var(--sodium-500)" stop-opacity=".18" />
              <stop offset="1" style="stop-color: var(--sodium-500)" stop-opacity="0" />
            </radialGradient>
            <!-- The floodlight is a cold LED white, like the hero's -->
            <radialGradient id="svc-spill" cx="206" cy="66" r="190" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#f4f8ff" stop-opacity=".68" />
              <stop offset=".35" stop-color="#dfe8f8" stop-opacity=".2" />
              <stop offset="1" stop-color="#dfe8f8" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="svc-beam" gradientUnits="userSpaceOnUse" x1="210" y1="66" x2="360" y2="290">
              <stop offset="0" stop-color="#f7faff" stop-opacity=".8" />
              <stop offset=".55" stop-color="#e4ecfb" stop-opacity=".24" />
              <stop offset="1" stop-color="#e4ecfb" stop-opacity=".05" />
            </linearGradient>
            <radialGradient id="svc-pool" cx="352" cy="272" r="140" gradientTransform="matrix(1 0 0 .2 0 217.6)" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#eef3fc" stop-opacity=".6" />
              <stop offset=".6" stop-color="#d6e0f2" stop-opacity=".15" />
              <stop offset="1" stop-color="#d6e0f2" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="svc-bulb" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset=".4" stop-color="#eaf1ff" stop-opacity=".55" />
              <stop offset="1" stop-color="#d4e2fb" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- Sky, the sodium glow of the estate beyond, a terrace roofline -->
          <rect width="480" height="300" fill="url(#svc-sky)" />
          <rect width="480" height="300" fill="url(#svc-horizon)" />
          <path class="t-roof" d="M232 204h248v-50l-34-22-34 22v-8h-16v12l-28-20-44 28-26-16-22 14-44 14Z" />
          <rect class="t-window" x="330" y="168" width="11" height="14" rx="1" opacity=".85" />
          <rect class="t-window" x="418" y="160" width="11" height="14" rx="1" opacity=".5" />
          <!-- A distant sodium streetlight -->
          <path class="t-pole" d="M462 204v-66h-10" fill="none" stroke-width="2" />
          <circle cx="451" cy="139" r="26" fill="url(#svc-street)" />
          <circle class="t-sodium" cx="451" cy="139" r="2.4" />

          <!-- Driveway -->
          <rect class="t-tarmac" y="236" width="480" height="64" />
          <path d="M230 236h250" stroke="#262d3a" stroke-width="2" />
          <ellipse class="lamp__pool" cx="352" cy="272" rx="140" ry="28" fill="url(#svc-pool)" />

          <!-- Pebbledash gable wall and its corner -->
          <rect class="t-render" width="232" height="240" />
          <rect width="232" height="240" fill="url(#svc-pebble)" />
          <rect class="lamp__spill" width="232" height="240" fill="url(#svc-spill)" />
          <path d="M231 0v240" stroke="#434a58" stroke-width="3" />
          <path d="M0 236h232" stroke="#1b202b" stroke-width="6" />

          <!-- A teal front door with a lit fanlight -->
          <rect class="t-window" x="46" y="92" width="80" height="18" rx="9" opacity=".82" />
          <path d="M46 101h80M66 92v18M86 92v18M106 92v18" stroke="#6f5530" stroke-width="1.6" />
          <rect x="42" y="112" width="88" height="124" rx="2" fill="#16504f" />
          <rect class="lamp__door-lit" x="42" y="112" width="88" height="124" rx="2" fill="#2d8f8a" />
          <rect x="52" y="124" width="30" height="42" rx="2" fill="none" stroke="#0f3a3a" stroke-width="2" />
          <rect x="90" y="124" width="30" height="42" rx="2" fill="none" stroke="#0f3a3a" stroke-width="2" />
          <rect x="52" y="178" width="30" height="46" rx="2" fill="none" stroke="#0f3a3a" stroke-width="2" />
          <rect x="90" y="178" width="30" height="46" rx="2" fill="none" stroke="#0f3a3a" stroke-width="2" />
          <rect x="72" y="170" width="28" height="5" rx="1.5" fill="#1a2230" />
          <circle cx="118" cy="174" r="2.6" fill="#1a2230" />

          <!-- Floodlight, PIR detector and cable -->
          <path class="t-pole" d="M194 18v26" stroke-width="2" />
          <rect x="186" y="44" width="14" height="22" rx="3" fill="#1b2230" />
          <g transform="rotate(24 200 64)">
            <rect x="194" y="50" width="30" height="24" rx="4" fill="#232b3a" />
            <path d="M198 50h22" stroke="#394358" stroke-width="2" stroke-linecap="round" />
            <rect class="lamp__lens" x="219" y="52" width="6" height="20" rx="2" fill="#f7faff" />
          </g>
          <circle class="lamp__bloom" cx="218" cy="72" r="34" fill="url(#svc-bulb)" />
          <rect x="185" y="84" width="16" height="10" rx="2" fill="#1b2230" />
          <path d="M186 94h14v4a7 7 0 0 1-14 0Z" fill="#5d6678" />
          <path d="M189 96h8" stroke="#8b94a6" stroke-width="1.4" stroke-linecap="round" opacity=".6" />
          <rect class="lamp__pir t-sodium" x="191" y="86.5" width="4" height="4" rx="1" />

          <!-- The beam, with rain falling through it -->
          <path class="lamp__beam" d="M207 58 214 76 240 300H480V232Z" fill="url(#svc-beam)" filter="url(#svc-soft)" />
        </svg>
        <!-- Rain in the beam: its own composited layer, so the fall is a pure
             transform instead of an SVG repaint every frame -->
        <div class="lamp__rainbox" aria-hidden="true">
          <svg class="lamp__rain" viewBox="0 -300 480 600" stroke="#eef4ff" stroke-width="1.2" stroke-linecap="round" fill="none" focusable="false">
            <path d={rain} />
            <path d={rain} transform="translate(0 -300)" />
          </svg>
        </div>
      </div>

      <div class="services__cta">
        <a class="btn btn--primary" href={company.phoneHref}>
          <Icon name="phone" />
          {servicesUi.call}
        </a>
        <a class="btn btn--ghost" href={hero.secondary.href}>{servicesUi.quote}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .services__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  /* DOM order is the reading and Tab order everywhere: intro, index, lamp */
  .services__aside {
    display: contents;
  }

  .services__title {
    max-width: 14ch;
  }
  .services__lede {
    margin-top: var(--space-5);
    max-width: 36ch;
    color: var(--ink-700);
  }

  /* ---------- Floodlight vignette ---------- */
  .lamp {
    --flood: 1;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--night-900);
    box-shadow: var(--shadow-flood);
  }
  .lamp__svg {
    width: 100%;
    height: 100%;
  }
  .t-roof {
    fill: color-mix(in oklab, var(--night-900) 88%, black);
  }
  .t-window {
    fill: var(--tungsten);
  }
  .t-pole {
    stroke: var(--tarmac);
  }
  .t-sodium {
    fill: var(--sodium-500);
  }
  .t-tarmac {
    fill: var(--tarmac);
  }
  /* Pebbledash render at night: the pebble colour, deep in shadow */
  .t-render {
    fill: color-mix(in oklab, var(--pebble) 20%, var(--night-900));
  }
  .lamp__beam {
    opacity: calc(var(--flood) * 0.95);
    mix-blend-mode: screen;
  }
  .lamp__spill,
  .lamp__pool {
    opacity: var(--flood);
  }
  .lamp__door-lit {
    opacity: calc(var(--flood) * 0.55);
  }
  .lamp__bloom {
    opacity: calc(var(--flood) * 0.9);
  }
  .lamp__lens {
    opacity: calc(0.25 + var(--flood) * 0.75);
  }
  .lamp__rainbox {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* the beam's footprint, in the vignette's 480x300 frame */
    clip-path: polygon(43.125% 19.33%, 44.58% 25.33%, 49.17% 100%, 100% 100%, 100% 78.67%);
  }
  .lamp__rain {
    position: absolute;
    left: 0;
    top: -100%;
    width: 100%;
    height: 200%;
    opacity: calc(var(--flood) * 0.5);
  }
  .lamp__pir {
    opacity: 0.35;
  }
  .lamp.is-detect .lamp__pir {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lamp.is-live .lamp__rain {
      animation: lamp-rain 0.85s linear infinite;
      will-change: transform;
    }
  }
  @keyframes lamp-rain {
    to {
      transform: translate(-6px, 50%);
    }
  }

  .services__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* ---------- The index: two groups, each a ruled list ---------- */
  .svc-group + .svc-group {
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
  }
  .svc-group__title {
    --draw: 1;
    position: relative;
    padding-bottom: clamp(0.85rem, 0.7rem + 0.5vw, 1.15rem);
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.35rem);
    font-stretch: 112%;
    font-weight: 740;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--ink-900);
  }
  /* The group's heavy rule, drawn in like a cable run as the group arrives */
  .svc-group__title::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink-900);
    transform-origin: 0 50%;
    scale: var(--draw) 1;
  }

  .svc {
    --mx: 30%;
    --my: 40%;
    --flash: 0;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    grid-template-areas:
      'icon name'
      'body body'
      'for for'
      'link link';
    column-gap: 0.9rem;
    align-items: center;
    padding: clamp(1.2rem, 1rem + 0.8vw, 1.75rem) clamp(0.25rem, -0.4rem + 2vw, 1.25rem);
    border-bottom: 1px solid var(--flood-300);
  }

  /* The light pool that follows the pointer inside a lit row: cold floodlight white */
  .svc::before,
  .svc::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .svc::before {
    background:
      radial-gradient(30rem 15rem at var(--mx) var(--my), var(--flood-0), color-mix(in srgb, var(--flood-0) 70%, transparent) 38%, transparent 72%),
      radial-gradient(12rem 8rem at var(--mx) var(--my), color-mix(in srgb, var(--sodium-300) 16%, transparent), transparent 70%),
      var(--flood-100);
    box-shadow: 0 1px 0 var(--flood-300), 0 16px 30px -22px color-mix(in srgb, var(--ink-900) 35%, transparent);
    opacity: 0;
    transition: opacity var(--dur-decay) var(--ease-out);
  }
  /* Arrival: the zone trips once as it scrolls into view */
  .svc::after {
    background: radial-gradient(22rem 11rem at 2.5rem 50%, color-mix(in srgb, var(--sodium-300) 40%, transparent), transparent 72%);
    opacity: var(--flash);
  }

  .svc:hover::before,
  .svc:focus-within::before {
    opacity: 1;
    transition-duration: var(--dur-trip);
  }
  @media (hover: none) {
    .svc:hover::before {
      opacity: 0;
    }
    .svc:focus-within::before {
      opacity: 1;
    }
  }

  .svc__icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink-900);
  }
  .svc__glyph {
    width: 2.35rem;
    height: 2.35rem;
    overflow: visible;
  }

  .svc__name {
    grid-area: name;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--ink-900);
    transition: translate var(--dur-decay) var(--ease-out);
  }
  .svc:hover .svc__name,
  .svc:focus-within .svc__name {
    translate: 0.3rem 0;
    transition-duration: var(--dur-med);
  }

  .svc__body {
    grid-area: body;
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--ink-700);
  }

  .svc__for {
    grid-area: for;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-4);
  }
  .svc__chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--flood-rule);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--flood-0) 60%, transparent);
    color: var(--ink-700);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .svc__link {
    grid-area: link;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: var(--space-2);
    color: var(--sodium-800);
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 680;
    font-size: var(--step-0);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--sodium-800) 35%, transparent);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out), color var(--dur-fast);
  }
  .svc__link :global(svg) {
    transition: translate var(--dur-med) var(--ease-out);
  }
  .svc__link:hover {
    color: var(--ink-900);
    text-decoration-color: currentColor;
  }
  .svc__link:hover :global(svg) {
    translate: 4px 0;
  }
  .svc__link:active {
    translate: 0 1px;
  }

  /* ---------- Glyph micro-animations ---------- */
  .svc__glyph :global(*) {
    transform-box: view-box;
  }
  .svc__glyph :global(.g-lit) {
    transition: stroke var(--dur-decay) var(--ease-out);
  }
  .svc:hover .svc__glyph :global(.g-lit),
  .svc:focus-within .svc__glyph :global(.g-lit) {
    stroke: var(--sodium-600);
    transition-duration: var(--dur-trip);
  }
  .svc__glyph :global(.g-led),
  .svc__glyph :global(.g-reader),
  .svc__glyph :global(.g-mled) {
    fill: var(--ink-500);
    transition: fill var(--dur-decay) var(--ease-out);
  }
  .svc__glyph :global(.g-dot) {
    fill: var(--strobe-500);
    opacity: 0;
    transform-origin: 16.6px 4.1px;
  }
  .svc__glyph :global(.g-buzz) {
    opacity: 0;
  }
  .svc:hover .svc__glyph :global(.g-dot),
  .svc:focus-within .svc__glyph :global(.g-dot) {
    opacity: 1;
  }
  .svc:hover .svc__glyph :global(.g-led),
  .svc:focus-within .svc__glyph :global(.g-led) {
    fill: var(--alarm-700);
  }
  /* The reader accepts the fob */
  .svc:hover .svc__glyph :global(.g-reader),
  .svc:focus-within .svc__glyph :global(.g-reader) {
    fill: var(--clear-700);
    transition-duration: var(--dur-trip);
  }
  /* The unit reports in */
  .svc:hover .svc__glyph :global(.g-mled),
  .svc:focus-within .svc__glyph :global(.g-mled) {
    fill: var(--strobe-500);
    transition-duration: var(--dur-trip);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-fan-1) {
      animation: g-fan 1.1s var(--ease-out) 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-fan-2) {
      animation: g-fan 1.1s var(--ease-out) 0.12s 2;
    }
    .svc__glyph :global(.g-head) {
      transform-origin: 9.5px 12.7px;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-head) {
      animation: g-pan 1.6s var(--ease-in-out);
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-smoke-1) {
      animation: g-smoke 1.2s var(--ease-out) 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-smoke-2) {
      animation: g-smoke 1.2s var(--ease-out) 0.3s 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-led) {
      animation: g-blink 0.6s steps(1, end) 3;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-beam) {
      stroke-dasharray: 1;
      animation: g-draw 0.9s var(--ease-snap) both;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-beam:nth-of-type(n + 5)) {
      animation-delay: 60ms;
    }
    /* Access: the door leaf swings open on its hinge once the reader is green */
    .svc__glyph :global(.g-leaf) {
      transform-origin: 5.9px 13px;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-leaf) {
      animation: g-swing 1.7s var(--ease-in-out);
    }
    .svc__glyph :global(.g-wrench) {
      transform-origin: 15.2px 8.6px;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-wrench) {
      animation: g-turn 1s var(--ease-in-out);
    }
    /* Maintenance: each check ticks off in turn, then the report is signed */
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-tick) {
      stroke-dasharray: 1;
      animation: g-draw 0.45s var(--ease-out) both;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-tick-2) {
      animation-delay: 0.3s;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-sign) {
      stroke-dasharray: 1;
      animation: g-draw 0.6s var(--ease-in-out) 0.6s both;
    }
    /* Monitoring: the signal goes out, inner arc then outer, twice */
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-sig) {
      animation: g-sig 0.7s steps(1, end) 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-sig-2) {
      animation-delay: 0.14s;
    }
    /* Call-out: the van rolls in and brakes; the air streams off behind it */
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-van) {
      animation: g-arrive 0.9s var(--ease-out);
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-speed) {
      animation: g-stream 0.9s var(--ease-out);
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-phone) {
      animation: g-buzz 0.5s linear 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-buzz) {
      animation: g-buzz-lines 0.5s steps(2, end) 2;
    }
    .svc:is(:hover, :focus-within) .svc__glyph :global(.g-dot) {
      animation: g-pop 0.5s var(--ease-out) 0.55s both;
    }
  }

  @keyframes g-fan {
    0% { translate: 0 0; opacity: 1; }
    45% { translate: 0 1.6px; opacity: 0.25; }
    46% { translate: 0 -1px; opacity: 0; }
    100% { translate: 0 0; opacity: 1; }
  }
  @keyframes g-pan {
    0%, 100% { rotate: 0deg; }
    35% { rotate: -9deg; }
    70% { rotate: 8deg; }
  }
  @keyframes g-smoke {
    0% { translate: 0 0; opacity: 1; }
    70% { translate: 0 -3px; opacity: 0; }
    71% { translate: 0 2px; opacity: 0; }
    100% { translate: 0 0; opacity: 1; }
  }
  @keyframes g-blink {
    50% { fill: var(--ink-500); }
  }
  @keyframes g-draw {
    0% { stroke-dashoffset: 1; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes g-swing {
    0%, 18% { scale: 1 1; }
    42%, 72% { scale: 0.42 1; }
    100% { scale: 1 1; }
  }
  @keyframes g-turn {
    0%, 100% { rotate: 0deg; }
    45% { rotate: -32deg; }
    65% { rotate: -28deg; }
  }
  @keyframes g-sig {
    0% { opacity: 0.15; }
    30% { opacity: 1; }
  }
  @keyframes g-arrive {
    0% { translate: -2.2px 0; }
    55% { translate: 0.7px 0; }
    78% { translate: -0.2px 0; }
    100% { translate: 0 0; }
  }
  @keyframes g-stream {
    0% { translate: 1.2px 0; opacity: 1; }
    60% { translate: -1.4px 0; opacity: 0.2; }
    100% { translate: 0 0; opacity: 1; }
  }
  @keyframes g-buzz {
    0%, 100% { translate: 0 0; }
    20% { translate: -0.8px 0; }
    40% { translate: 0.8px 0; }
    60% { translate: -0.6px 0; }
    80% { translate: 0.6px 0; }
  }
  @keyframes g-buzz-lines {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes g-pop {
    0% { scale: 0.2; opacity: 0; }
    60% { scale: 1.2; opacity: 1; }
    100% { scale: 1; opacity: 1; }
  }

  /* ---------- Wider rows: chips sit opposite the name ---------- */
  @media (min-width: 640px) {
    .svc {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      grid-template-areas:
        'icon name for'
        '. body body'
        '. link link';
      column-gap: 1.25rem;
    }
    .svc__icon {
      width: 3rem;
      height: 3rem;
    }
    .svc__glyph {
      width: 2.6rem;
      height: 2.6rem;
    }
    .svc__for {
      margin-top: 0;
      justify-content: flex-end;
      align-self: center;
    }
  }

  /* ---------- Desktop: the lamp and CTA stay beside the index ---------- */
  @media (min-width: 1024px) {
    .services__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 1rem + 5vw, 7rem);
      align-items: start;
    }
    .services__layout {
      grid-template-rows: auto 1fr;
    }
    .services__intro {
      grid-column: 1;
      grid-row: 1;
    }
    .svc-index {
      grid-column: 2;
      grid-row: 1 / 3;
      margin-top: 0.4rem;
    }
    /* Row 2 runs the rest of the index's height, so the lamp can stick in it */
    .services__lamp {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
  }
  /* Only the vignette and its buttons stick (about 360-420px tall), centred in
     the viewport where there is room, never under the header. */
  @media (min-width: 1024px) and (min-height: 620px) {
    .services__lamp {
      position: sticky;
      top: max(calc(var(--header-h) + 1.5rem), calc(50svh - 13rem));
    }
  }
</style>

<script>
  import { boot, gsap, ScrollTrigger, motionOK, isTouch, later } from '../scripts/motion.js';

  boot();

  // Nothing here is needed to read or use the section, so it is built after
  // first paint, in idle time.
  later(() => {
    const root = document.querySelector('[data-services]');
    const lamp = root?.querySelector('[data-lamp]');
    if (!root || !lamp) return;
    const rows = [...root.querySelectorAll('[data-svc]')];
    const heads = [...root.querySelectorAll('[data-svc-group-title]')];

    // Keep the rain running only while the vignette is on screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => lamp.classList.toggle('is-live', entry.isIntersecting), {
        rootMargin: '80px',
      }).observe(lamp);
    }

    if (!motionOK()) return;

    // Anything the reader has already reached (a deep link, a fast scroll)
    // stays lit: only what is still below the fold waits to switch on.
    // All positions are read before any state is written (one layout pass).
    const ahead = (el, at) => el.getBoundingClientRect().top > window.innerHeight * at;
    const lampAhead = ahead(lamp, 0.78);
    const headsAhead = heads.filter((h) => ahead(h, 0.86));
    const waiting = rows.filter((row) => ahead(row, 0.86));

    // trip: the floodlight snaps on when the vignette arrives, flickers, settles
    if (lampAhead) {
      gsap.set(lamp, { '--flood': 0 });
      gsap
        .timeline({ scrollTrigger: { trigger: lamp, start: 'top 78%', once: true } })
        .to(lamp, { '--flood': 1.12, duration: 0.07, ease: 'none' }, 0.25)
        .to(lamp, { '--flood': 0.55, duration: 0.06, ease: 'none' })
        .to(lamp, { '--flood': 1.05, duration: 0.05, ease: 'none' })
        .to(lamp, { '--flood': 1, duration: 1.2, ease: 'decay' });
    }

    // cable: each group's rule is drawn in as its heading arrives
    headsAhead.forEach((head) => {
      gsap.set(head, { '--draw': 0 });
      gsap.to(head, {
        '--draw': 1,
        duration: 1,
        ease: 'power2.inOut',
        scrollTrigger: { trigger: head, start: 'top 86%', once: true },
      });
    });

    // Each zone trips once as it scrolls in: the row lights, then decays
    const parts = new Map(
      waiting.map((row) => [row, row.querySelectorAll('.svc__icon, .svc__name, .svc__body, .svc__for, .svc__link')]),
    );
    parts.forEach((els) => gsap.set(els, { opacity: 0.18, y: 12 }));

    if (waiting.length) {
      ScrollTrigger.batch(waiting, {
        start: 'top 86%',
        once: true,
        onEnter: (batch) => {
          batch.forEach((row, i) => {
            const els = parts.get(row);
            gsap
              .timeline({ delay: i * 0.12 })
              .to(els, {
                keyframes: [
                  { opacity: 0.9, duration: 0.06, ease: 'none' },
                  { opacity: 0.55, duration: 0.05, ease: 'none' },
                  { opacity: 1, duration: 0.7, ease: 'expo.out' },
                ],
                stagger: 0.05,
              })
              .to(els, { y: 0, duration: 0.9, ease: 'expo.out', stagger: 0.05, clearProps: 'transform' }, 0)
              .fromTo(
                row,
                { '--flash': 0 },
                {
                  keyframes: [
                    { '--flash': 1, duration: 0.07, ease: 'none' },
                    { '--flash': 0.6, duration: 0.06, ease: 'none' },
                    { '--flash': 0, duration: 1.3, ease: 'decay' },
                  ],
                },
                0,
              );
          });
        },
      });
    }

    // A row under the pointer is someone walking past the sensor: re-trip the lamp
    let last = null;
    let lastAt = 0;
    const retrip = (row) => {
      const now = performance.now();
      if (row === last && now - lastAt < 1500) return;
      if (now - lastAt < 350) return;
      last = row;
      lastAt = now;
      lamp.classList.add('is-detect');
      gsap.delayedCall(0.7, () => lamp.classList.remove('is-detect'));
      gsap.killTweensOf(lamp);
      gsap
        .timeline()
        .to(lamp, { '--flood': 0.6, duration: 0.05, ease: 'none' })
        .to(lamp, { '--flood': 1.15, duration: 0.07, ease: 'none' })
        .to(lamp, { '--flood': 1, duration: 1, ease: 'decay' });
    };
    if (!isTouch()) rows.forEach((row) => row.addEventListener('pointerenter', () => retrip(row)));
    rows.forEach((row) => row.addEventListener('focusin', () => retrip(row)));
  });
</script>
