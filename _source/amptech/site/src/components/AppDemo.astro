</style>

<script>
  import { boot, gsap, ScrollTrigger, motionOK, isTouch, strobe, sweepIn, later } from '../scripts/motion.js';

  boot();

  const section = document.querySelector('[data-app]');
  if (section) initApp(section);

  function initApp(root) {
    const stage = root.querySelector('[data-phone-stage]');
    const tilt = root.querySelector('[data-phone-tilt]');
    const phone = root.querySelector('[data-phone]');
    const screen = root.querySelector('[data-screen]');
    const dim = root.querySelector('[data-dim]');
    const glare = root.querySelector('[data-glare]');
    const feed = root.querySelector('[data-feed]');
    const tpl = (name) => root.querySelector(`[data-note-tpl="${name}"]`);
    const btn = root.querySelector('[data-test-alert]');
    const live = root.querySelector('[data-live]');
    const buzzMarks = root.querySelector('[data-buzz]');
    const panel = root.querySelector('[data-mode-panel]');
    const control = root.querySelector('[data-mode-control]');
    const modeLed = root.querySelector('[data-mode-led]');
    const modeText = [...root.querySelectorAll('[data-mode-text]')];
    const leds = [...root.querySelectorAll('[data-led]')];
    const earlier = btn.dataset.earlier;
    const MAX = 4;
    const moving = motionOK();

    // The demo needs JS, so its controls only appear once JS is running.
    btn.hidden = false;
    control.hidden = false;

    const ledOn = (i) => leds[i]?.classList.add('is-on');
    // Flick an LED again (fast attack, slow settle) when the phone shows its feature working.
    const retrip = (el) => {
      if (!el || !moving || document.documentElement.classList.contains('motion-paused')) return;
      el.classList.remove('is-trip');
      void el.offsetWidth;
      el.classList.add('is-trip');
    };
    const announce = (text) => {
      live.textContent = '';
      window.setTimeout(() => (live.textContent = text), 80);
    };

    // A note collapses to nothing, then drops in from above and pushes the feed down.
    const collapse = (note) => {
      gsap.set(note, { height: 0, overflow: 'hidden' });
      gsap.set(note.firstElementChild, { opacity: 0, yPercent: -45, scale: 0.97 });
    };
    const naturalHeight = (note) => {
      const prev = note.style.height;
      note.style.height = 'auto';
      const h = note.offsetHeight;
      note.style.height = prev;
      return h;
    };
    const dropIn = (note) =>
      gsap
        .timeline()
        .to(note, { height: () => naturalHeight(note), duration: 0.62, ease: 'expo.out' })
        .to(note.firstElementChild, { opacity: 1, yPercent: 0, scale: 1, duration: 0.7, ease: 'expo.out' }, 0)
        .set(note, { clearProps: 'height,overflow' });

    // Bell-box strobe on the card and the screen edge, and the phone buzzes.
    const alertFx = (note) => {
      const tl = gsap.timeline();
      const a = strobe(note.firstElementChild);
      const b = strobe(screen);
      if (a) tl.add(a, 0);
      if (b) tl.add(b, 0);
      tl.to(
        phone,
        {
          keyframes: { x: [0, -2.5, 2.5, -2, 2, -1, 0], rotation: [0, -0.7, 0.7, -0.5, 0.4, -0.2, 0] },
          duration: 0.42,
          ease: 'none',
        },
        0.02,
      ).fromTo(buzzMarks, { opacity: 0 }, { keyframes: { opacity: [0, 0.9, 0.15, 0.9, 0] }, duration: 0.46, ease: 'none' }, 0.02);
      return tl;
    };

    // The camera still arrives line by line, a scan passing down it.
    const revealStill = (img) => {
      const scan = img.querySelector('[data-scan]');
      return gsap
        .timeline()
        .fromTo(img.querySelector('svg'), { clipPath: 'inset(0% 0% 100% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'power2.inOut' })
        .fromTo(scan, { y: 0, opacity: 1 }, { y: () => img.offsetHeight - 2, duration: 0.9, ease: 'power2.inOut' }, 0)
        .to(scan, { opacity: 0, duration: 0.3, ease: 'decay' });
    };

    let intro = null;
    const finishIntro = () => {
      if (intro && intro.progress() < 1) intro.progress(1);
      leds.forEach((_, i) => ledOn(i));
      root.dataset.demo = 'done';
    };

    // A new notification lands at the top of the feed; the feed keeps the four most recent.
    const addNote = (name, fx) => {
      finishIntro();
      feed.querySelectorAll('[data-time]').forEach((t) => (t.textContent = earlier));
      const note = tpl(name).content.firstElementChild.cloneNode(true);
      feed.prepend(note);
      const current = [...feed.children].filter((n) => !n.classList.contains('is-leaving'));
      current.slice(MAX).forEach((old) => {
        old.classList.add('is-leaving');
        if (moving) {
          gsap.set(old, { overflow: 'hidden' });
          gsap.to(old, { height: 0, opacity: 0, duration: 0.4, ease: 'power2.in', onComplete: () => old.remove() });
        } else old.remove();
      });
      if (moving) {
        collapse(note);
        const tl = gsap.timeline().add(dropIn(note));
        if (fx) tl.add(fx(note), 0.12);
      }
      return note;
    };

    // "Send a test alert": the phone lights, strobes and buzzes.
    btn.addEventListener('click', () => {
      addNote('alert', alertFx);
      retrip(leds[1]);
      announce(live.dataset.announce);
    });

    // Set / Unset: the state flips, the bell box confirms with its double blink,
    // and the change goes into the log.
    control.addEventListener('change', (event) => {
      const mode = event.target.value === 'unset' ? 'unset' : 'set';
      if (panel.dataset.mode === mode) return;
      panel.dataset.mode = mode;
      modeText.forEach((el) => (el.hidden = el.dataset.modeText !== mode));
      addNote(mode);
      strobe(panel);
      if (mode === 'set') retrip(modeLed);
      retrip(leds[0]);
      announce(mode === 'set' ? live.dataset.announceSet : live.dataset.announceUnset);
    });

    if (!moving) return;

    // Everything below is presentation, built in idle time after first paint.
    later(() => {
      const heading = root.querySelector('#app-title');
      const below = (el, at = 1) => el.getBoundingClientRect().top > window.innerHeight * at;

      // Headings already on screen (a deep link, a fast scroll) stay put.
      if (below(heading)) sweepIn(heading);

      // The sky brightens from the horizon as the section rises into view.
      gsap.fromTo(
        root.querySelector('[data-app-glow]'),
        { scaleY: 0.5, opacity: 0.55 },
        { scaleY: 1, opacity: 1, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom bottom', scrub: 0.6 } },
      );

      // 02:14: the phone wakes as the notifications land. Only if the reader
      // hasn't reached it yet or already used it.
      if (root.dataset.demo !== 'done' && below(stage, 0.72)) {
        root.dataset.demo = 'pending';
        const notes = [...feed.children]; // newest first: alert, armed, door
        const [alert, armed, door] = notes;
        const still = alert?.querySelector('[data-still]');
        notes.forEach(collapse);
        gsap.set(dim, { opacity: 0.62 });

        intro = gsap.timeline({ paused: true, onComplete: finishIntro });
        intro
          .add(dropIn(door), 0.3)
          .add(dropIn(armed), 0.95)
          .call(ledOn, [0], 1.2)
          // The screen wakes (a trip: instant attack) as the motion alert lands.
          .to(dim, { opacity: 0, duration: 0.1, ease: 'trip' }, 2.35)
          .add(dropIn(alert), 2.35)
          .add(alertFx(alert), 2.5)
          .call(ledOn, [1], 2.5);
        if (still) intro.add(revealStill(still), 2.85).call(ledOn, [2], 3.4);

        const play = () => intro.progress() < 1 && intro.play();
        ScrollTrigger.create({ trigger: stage, start: 'top 72%', end: 'bottom top', onEnter: play, onEnterBack: play });
      } else {
        finishIntro();
      }

      // Desktop pointer: the phone turns gently toward the cursor, the glass sheen slides.
      if (!isTouch()) {
        gsap.set(tilt, { transformPerspective: 1100 });
        const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.9, ease: 'power3.out' });
        const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.9, ease: 'power3.out' });
        const gx = gsap.quickTo(glare, 'xPercent', { duration: 0.9, ease: 'power3.out' });
        root.addEventListener(
          'pointermove',
          (e) => {
            if (e.pointerType !== 'mouse') return;
            const r = stage.getBoundingClientRect();
            const nx = gsap.utils.clamp(-1, 1, (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2));
            const ny = gsap.utils.clamp(-1, 1, (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2));
            ry(nx * 8);
            rx(-ny * 6);
            gx(nx * 14);
          },
          { passive: true },
        );
        root.addEventListener('pointerleave', () => {
          rx(0);
          ry(0);
          gx(0);
        });
      }
    });
  }
</script>
