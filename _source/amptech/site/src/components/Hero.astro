---
// Hero: a street of Irish semi-ds at night. Four posters, rendered from the
// three.js scene by tools/capture-hero.mjs at tall, square, wide and very wide
// shapes, are the static fallback and the first frame; the live scene fades in
// over them when motion is allowed, framed exactly like the poster on screen.
import Icon from './Icon.astro';
import { hero, heroScene } from '../data/content.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const poster = (name: string) => `${base}hero/poster-${name}.webp`;
// The licence number speaks in the data voice; nothing else in the proof line does.
const withData = (s: string) => s.replace(/(licence\s+)(\d+)/gi, '$1<span class="hero__num">$2</span>');
---

<section id="top" class="hero is-night" aria-labelledby="hero-title" data-hero>
  <script is:inline>
    (function () {
      var paused = false;
      try {
        paused = localStorage.getItem('amptech:motion-paused') === '1';
      } catch (e) {}
      if (!paused && matchMedia('(prefers-reduced-motion: no-preference)').matches && !/[?&]poster/.test(location.search))
        document.documentElement.classList.add('hero-intro');
    })();
  </script>

  <div class="hero__stage" aria-hidden="true">
    <!-- Media bands must match the .hero__poster object-position rules below; scene.js reads both. -->
    <picture>
      <source media="(max-aspect-ratio: 4/5)" srcset={poster('tall')} type="image/webp" width="900" height="1500" />
      <source media="(max-aspect-ratio: 5/4)" srcset={poster('square')} type="image/webp" width="1200" height="1200" />
      <source media="(max-aspect-ratio: 37/20)" srcset={poster('wide')} type="image/webp" width="1600" height="1000" />
      <img
        class="hero__poster"
        src={poster('ultra')}
        width="2100"
        height="1000"
        alt=""
        fetchpriority="high"
        data-hero-poster
      />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__hud" data-hero-hud aria-hidden="true">
    <div class="hero__osd data" data-hero-osd>
      <span class="hero__osd-row">
        <span class="hero__rec"><i></i>{heroScene.rec}</span>
        <span class="hero__cam" data-osd-cam>{hero.camLabel}</span>
      </span>
      <span class="hero__time" data-osd-time></span>
    </div>

    <div class="hero__hint" data-hero-hint hidden>
      <span class="hero__hint-ring"></span>
      <span class="hero__hint-stem"></span>
      <span class="hero__hint-label">
        <svg class="hero__glyph hero__glyph--pointer" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 3.5v14l3.6-3.4 2.5 5.4 2.4-1.1-2.5-5.3h5Z" />
          <path d="M16.5 4.5 18 3M18.5 7.5h2" opacity=".6" />
        </svg>
        <svg class="hero__glyph hero__glyph--touch" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="13.5" r="2.4" />
          <path d="M7.4 13.5a4.6 4.6 0 0 1 9.2 0" opacity=".8" />
          <path d="M4.4 13.5a7.6 7.6 0 0 1 15.2 0" opacity=".45" />
        </svg>
        <span data-hint-text>{hero.hintPointer}</span>
      </span>
    </div>

    <div class="hero__track" data-hero-track><span class="data">{heroScene.trackLabel}</span></div>
  </div>

  <div class="hero__content container" data-hero-content>
    <h1 id="hero-title" class="h-display hero__title">{hero.title}</h1>
    <p class="lede hero__lede" data-trip>{hero.lede}</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href={hero.primary.href} data-trip>
        <Icon name="phone" />
        <span>{hero.primary.label}</span>
      </a>
      <a class="btn btn--ghost hero__ghost" href={hero.secondary.href} data-trip>{hero.secondary.label}</a>
    </div>
    <ul class="hero__proof" role="list" data-trip>
      {
        hero.proof.map((item) => (
          <li>
            <Icon name="check" size={18} />
            <span set:html={withData(item)} />
          </li>
        ))
      }
    </ul>
    <p class="visually-hidden">{hero.sceneLabel}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 640px);
    padding-top: calc(var(--header-h) + 7rem);
    padding-bottom: clamp(2rem, 1rem + 4.5vh, 4.75rem);
    overflow: clip;
    background: var(--night-950);
    color: var(--dusk-50);
  }

  /* ---------- Stage: poster, live canvas, scrims ---------- */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 70% at 60% 45%, var(--night-800) 0%, var(--night-950) 70%);
  }
  .hero__stage picture,
  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* One object-position per poster band (see the <source> media above).
     scene.js reads the computed value to frame the live camera identically. */
  .hero__poster {
    object-fit: cover;
    object-position: 80% 50%; /* keep the house and the floodlit drive; the words sit left */
    transform-origin: 70% 55%;
  }
  @media (max-aspect-ratio: 5/4) {
    .hero__poster {
      object-position: 72% 50%;
    }
  }
  @media (max-aspect-ratio: 4/5) {
    .hero__poster {
      object-position: 50% 50%;
    }
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.1s var(--ease-out);
  }
  .hero.is-live .hero__canvas {
    opacity: 1;
  }

  /* Scrims guarantee headline and lede contrast over any part of the scene.
     The bottom runs into the page's dusk ground, overcast grain included, so
     the next night section continues it without a seam. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--night-900) 0%, transparent 14%),
      radial-gradient(
        ellipse 72% 88% at 0% 100%,
        color-mix(in srgb, var(--night-950) 90%, transparent) 0%,
        color-mix(in srgb, var(--night-950) 74%, transparent) 46%,
        transparent 100%
      ),
      linear-gradient(to bottom, color-mix(in srgb, var(--night-950) 55%, transparent) 0%, transparent 22%);
  }
  .hero__stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 26%;
    background: var(--grain);
    background-size: 220px 220px;
    -webkit-mask-image: linear-gradient(to top, #000, transparent);
    mask-image: linear-gradient(to top, #000, transparent);
    pointer-events: none;
  }

  /* ---------- Content ---------- */
  .hero__content {
    position: relative;
    z-index: 2;
  }
  .hero__title {
    max-width: 11.5ch;
    font-size: clamp(2.6rem, min(1.2rem + 4.6vw, 0.6rem + 9.5vh), 5.5rem);
    text-shadow: 0 2px 30px color-mix(in srgb, var(--night-950) 55%, transparent);
  }
  .hero__lede {
    margin-top: clamp(1.1rem, 0.8rem + 1vw, 1.75rem);
    max-width: 40ch;
    color: var(--dusk-200);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
  }
  .hero__ctas .btn--primary {
    font-variant-numeric: tabular-nums;
  }
  .hero__ghost {
    --btn-bg: color-mix(in srgb, var(--night-950) 45%, transparent);
    --btn-border: color-mix(in srgb, var(--dusk-200) 38%, transparent);
  }
  .hero__ghost:hover {
    --btn-bg: color-mix(in srgb, var(--sodium-500) 10%, transparent);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--dusk-200);
  }
  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__proof :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--sodium-500);
  }
  .hero__proof :global(.hero__num) {
    font-family: var(--font-data);
    font-size: 0.88em;
    font-stretch: 88%;
    letter-spacing: 0.02em;
    color: var(--dusk-50);
  }

  /* ---------- HUD: CCTV on-screen display, hint, motion box ---------- */
  .hero__hud {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero__osd {
    position: absolute;
    top: calc(var(--header-h) + 0.9rem);
    right: max(var(--gutter), (100% - var(--max)) / 2);
    display: grid;
    justify-items: end;
    gap: 0.3rem;
    color: var(--dusk-50);
    text-shadow: 0 1px 2px color-mix(in srgb, var(--night-950) 85%, transparent);
  }
  .hero__osd-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hero__rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  /* The recording LED is a light source, so it may bloom */
  .hero__rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sodium-500);
    box-shadow: 0 0 8px 1px var(--sodium-glow);
  }
  .hero__cam {
    transition: color var(--dur-trip) linear;
  }
  .hero.is-motion .hero__cam {
    color: var(--sodium-400);
  }
  .hero__time {
    color: var(--dusk-200);
    min-height: 1.2em;
  }

  .hero__hint {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    color: var(--flood-50);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .hero__hint.is-on {
    opacity: 1;
  }
  .hero__hint.is-muted {
    opacity: 0;
    transition-duration: 0.2s;
  }
  .hero__hint-ring {
    position: absolute;
    left: -20px;
    top: -7px;
    width: 40px;
    height: 14px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0.85;
  }
  .hero__hint-stem {
    position: absolute;
    left: -0.5px;
    bottom: 2px;
    width: 1px;
    height: 54px;
    background: linear-gradient(to top, currentColor, color-mix(in srgb, currentColor 15%, transparent));
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.7s var(--ease-out) 0.15s;
  }
  .hero__hint.is-on .hero__hint-stem {
    transform: scaleY(1);
  }
  .hero__hint-label {
    position: absolute;
    left: 0;
    bottom: 58px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem 0.45rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--flood-50) 18%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--night-950) 80%, transparent);
    color: var(--flood-50);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    width: max-content;
    box-shadow: var(--shadow-1);
    transform: translateX(calc(-50% + var(--shift, 0px)));
  }
  .hero__glyph {
    flex: none;
    width: 18px;
    height: 18px;
    max-width: none;
    color: var(--sodium-400);
  }
  .hero__glyph--touch,
  .hero__hint.is-touch .hero__glyph--pointer {
    display: none;
  }
  .hero__hint.is-touch .hero__glyph--touch {
    display: block;
  }

  .hero__track {
    --c: 12px;
    --t: 1.5px;
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 90px;
    color: var(--sodium-400);
    opacity: 0;
    background:
      linear-gradient(currentColor 0 0) top left / var(--c) var(--t),
      linear-gradient(currentColor 0 0) top left / var(--t) var(--c),
      linear-gradient(currentColor 0 0) top right / var(--c) var(--t),
      linear-gradient(currentColor 0 0) top right / var(--t) var(--c),
      linear-gradient(currentColor 0 0) bottom left / var(--c) var(--t),
      linear-gradient(currentColor 0 0) bottom left / var(--t) var(--c),
      linear-gradient(currentColor 0 0) bottom right / var(--c) var(--t),
      linear-gradient(currentColor 0 0) bottom right / var(--t) var(--c);
    background-repeat: no-repeat;
    transition: opacity 0.9s var(--ease-out);
  }
  .hero__track.is-on {
    opacity: 1;
    transition-duration: 0.12s;
  }
  .hero__track .data {
    position: absolute;
    left: 0;
    bottom: calc(100% + 5px);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: var(--sodium-500);
    color: var(--night-950);
    font-size: 0.66rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* ---------- Loops ----------
     The REC blink and the hint ring stop off screen (hero.js sets .is-away)
     and with the header's pause control (html.motion-paused, base.css). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__rec i {
      animation: rec 1.6s steps(1, end) infinite;
    }
    .hero.is-motion .hero__rec i {
      animation-duration: 0.5s;
    }
    .hero__hint.is-on .hero__hint-ring {
      animation: ring-pulse 2.2s var(--ease-out) infinite;
    }
    .hero__track.is-on {
      animation: box-trip 0.28s linear;
    }
    .hero.is-away .hero__rec i,
    .hero.is-away .hero__hint-ring {
      animation-play-state: paused;
    }
  }
  @keyframes rec {
    50% {
      opacity: 0.15;
    }
  }
  @keyframes ring-pulse {
    0% {
      transform: scale(0.55);
      opacity: 0.95;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  @keyframes box-trip {
    0% { opacity: 0; }
    18% { opacity: 1; }
    32% { opacity: 0.3; }
    48%, 100% { opacity: 1; }
  }

  /* ---------- Entrance ----------
     Pure CSS from first paint, so it never waits for the scripts and can't
     replay when they land. Nothing is ever invisible (the headline is the LCP
     element and is painted in the first frame): it starts as a dim ghost and a
     detection beam sweeps it lit; the rest trips on like a floodlight from a
     low glow. The inline script adds .hero-intro only when motion is allowed
     and not paused; with JS off or reduced motion everything is simply there.
     Once started it finishes, even if the pause control is pressed mid-way. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.hero-intro) .hero__title {
      -webkit-mask-image: linear-gradient(100deg, #000 42%, rgb(0 0 0 / 0.16) 56%);
      mask-image: linear-gradient(100deg, #000 42%, rgb(0 0 0 / 0.16) 56%);
      -webkit-mask-size: 300% 100%;
      mask-size: 300% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      animation: hero-sweep 1.2s cubic-bezier(0.45, 0, 0.2, 1) 0.14s both;
    }
    :global(.hero-intro) .hero__osd,
    :global(.hero-intro) [data-trip] {
      animation:
        hero-trip 0.7s linear var(--d, 0s) both,
        hero-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) both;
    }
    :global(.hero-intro) .hero__osd {
      --d: 0.04s;
      animation-name: hero-trip, none;
    }
    :global(.hero-intro) .hero__lede {
      --d: 0.42s;
    }
    :global(.hero-intro) .hero__ctas .btn--primary {
      --d: 0.52s;
    }
    :global(.hero-intro) .hero__ghost {
      --d: 0.6s;
    }
    :global(.hero-intro) .hero__proof {
      --d: 0.68s;
    }
    :global(.motion-paused) .hero__title,
    :global(.motion-paused) .hero__osd,
    :global(.motion-paused) [data-trip] {
      animation-play-state: running !important;
    }
  }
  @keyframes hero-sweep {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }
  @keyframes hero-trip {
    0% {
      opacity: 0.1;
    }
    7% {
      opacity: 0.9;
    }
    13% {
      opacity: 0.35;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(10px);
    }
  }

  /* ---------- Layout by shape ----------
     Wide: full-bleed scene, words lower left. Tall or narrow: the scene on top,
     words below it. Short (landscape phones, squat windows): the wide layout,
     compacted so the headline and the call button fit the first screen. */
  @media (min-aspect-ratio: 5/4) and (min-width: 900px) {
    .hero {
      padding-top: calc(var(--header-h) + clamp(2rem, 9vh, 7rem));
    }
    .hero__title {
      max-width: 12ch;
    }
    /* The headline leads; the lede supports it and stays left of the lamp post */
    .hero__lede {
      max-width: 44ch;
      font-size: clamp(1.125rem, 0.95rem + 0.35vw, 1.3rem);
    }
  }
  @media (max-aspect-ratio: 5/4), (max-width: 899px) and (min-height: 541px) {
    .hero {
      /* The scene gets 36% of the screen, less on short phones so the call
         button still makes the first screen (~29rem of words sit above it). */
      --scene: calc(var(--header-h) + clamp(6rem, min(100svh - 29rem, 36svh), 30rem));
      --veil: 35%;
      padding-top: var(--scene);
    }
    /* The veil starts where the words start, however far up a short phone pushes them */
    .hero__scrim {
      background:
        linear-gradient(
          to bottom,
          transparent calc(var(--scene) - 5.5rem),
          color-mix(in srgb, var(--night-950) var(--veil), transparent) calc(var(--scene) + 1rem),
          color-mix(in srgb, var(--night-900) 90%, transparent) calc(var(--scene) + 10rem),
          var(--night-900) 100%
        ),
        linear-gradient(to bottom, color-mix(in srgb, var(--night-950) 55%, transparent) 0%, transparent 20%);
    }
    .hero__lede {
      font-size: var(--step-0);
    }
  }
  /* On short phones the headline climbs over the lit house: a heavier veil */
  @media (max-aspect-ratio: 5/4) and (max-height: 700px) {
    .hero {
      --veil: 62%;
    }
  }
  @media (min-aspect-ratio: 5/4) and (max-height: 540px) {
    .hero {
      min-height: 100svh;
      padding-top: calc(var(--header-h) + 0.75rem);
      padding-bottom: 1rem;
    }
    /* The words take most of the width here, so the veil runs across, not up from a corner */
    .hero__scrim {
      background:
        linear-gradient(to top, var(--night-900) 0%, transparent 18%),
        linear-gradient(
          to right,
          color-mix(in srgb, var(--night-950) 88%, transparent) 0%,
          color-mix(in srgb, var(--night-950) 78%, transparent) 45%,
          color-mix(in srgb, var(--night-950) 40%, transparent) 68%,
          transparent 86%
        );
    }
    .hero__title {
      max-width: 18ch;
      font-size: clamp(1.9rem, 10svh, 3.25rem);
    }
    .hero__lede {
      margin-top: 0.6rem;
      max-width: 50ch;
      font-size: var(--step-0);
      line-height: 1.45;
    }
    .hero__ctas {
      margin-top: 0.9rem;
    }
    .hero__ctas .btn {
      min-height: 48px;
      padding-block: 0.6rem;
    }
    .hero__proof {
      margin-top: 0.8rem;
    }
    .hero__osd {
      top: calc(var(--header-h) + 0.4rem);
    }
  }
  /* Small landscape phones: the words span nearly the whole width */
  @media (min-aspect-ratio: 5/4) and (max-height: 540px) and (max-width: 699px) {
    .hero__scrim {
      background:
        linear-gradient(to top, var(--night-900) 0%, transparent 18%),
        linear-gradient(
          to right,
          color-mix(in srgb, var(--night-950) 88%, transparent) 0%,
          color-mix(in srgb, var(--night-950) 80%, transparent) 70%,
          color-mix(in srgb, var(--night-950) 60%, transparent) 100%
        );
    }
  }
  @media (max-width: 519px) {
    .hero__ctas {
      display: grid;
    }
    .hero__osd {
      top: calc(var(--header-h) + 0.4rem);
      font-size: 0.66rem;
    }
    .hero__proof {
      display: grid;
      gap: 0.4rem;
    }
  }
  @media (max-width: 359px) {
    .hero__title {
      font-size: 2.3rem;
    }
  }
</style>

<script>
  import { initHero } from '../scripts/hero/hero.js';
  initHero();
</script>
