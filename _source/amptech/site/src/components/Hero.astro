---
// Hero: a street of Irish semi-ds at night. The poster (rendered from the
// three.js scene by tools/capture-hero.mjs) is the LCP image and the static
// fallback; the live scene fades in over it after load when motion is allowed.
import Icon from './Icon.astro';
import { hero, heroScene } from '../data/content.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posterWide = `${base}hero/poster-wide.webp`;
const posterTall = `${base}hero/poster-tall.webp`;
// Licence and standard numbers speak in the data voice.
const withData = (s: string) => s.replace(/((?:EN )?\d[\d-]*\d)/g, '<span class="hero__num">$1</span>');
---

<section id="top" class="hero is-night" aria-labelledby="hero-title" data-hero>
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches && !/[?&]poster/.test(location.search))
      document.documentElement.classList.add('hero-intro');
  </script>

  <div class="hero__stage" aria-hidden="true">
    <picture>
      <source media="(max-aspect-ratio: 4/5)" srcset={posterTall} type="image/webp" width="900" height="1500" />
      <img
        class="hero__poster"
        src={posterWide}
        width="1600"
        height="1000"
        alt=""
        fetchpriority="high"
        data-hero-poster
      />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__hud" data-hero-hud aria-hidden="true">
    <div class="hero__osd data" data-hero-osd>
      <span class="hero__osd-row">
        <span class="hero__rec"><i></i>{heroScene.rec}</span>
        <span class="hero__cam" data-osd-cam>{hero.camLabel}</span>
      </span>
      <span class="hero__time" data-osd-time></span>
    </div>

    <div class="hero__hint" data-hero-hint hidden>
      <span class="hero__hint-ring"></span>
      <span class="hero__hint-stem"></span>
      <span class="hero__hint-label">
        <svg class="hero__glyph hero__glyph--pointer" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 3.5v14l3.6-3.4 2.5 5.4 2.4-1.1-2.5-5.3h5Z" />
          <path d="M16.5 4.5 18 3M18.5 7.5h2" opacity=".6" />
        </svg>
        <svg class="hero__glyph hero__glyph--touch" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="13.5" r="2.4" />
          <path d="M7.4 13.5a4.6 4.6 0 0 1 9.2 0" opacity=".8" />
          <path d="M4.4 13.5a7.6 7.6 0 0 1 15.2 0" opacity=".45" />
        </svg>
        <span data-hint-text>{hero.hintPointer}</span>
      </span>
    </div>

    <div class="hero__track" data-hero-track><span class="data">{heroScene.trackLabel}</span></div>
  </div>

  <div class="hero__content container" data-hero-content>
    <h1 id="hero-title" class="h-display hero__title">{hero.title}</h1>
    <p class="lede hero__lede" data-trip>{hero.lede}</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href={hero.primary.href} data-trip>
        <Icon name="phone" />
        <span>{hero.primary.label}</span>
      </a>
      <a class="btn btn--ghost hero__ghost" href={hero.secondary.href} data-trip>{hero.secondary.label}</a>
    </div>
    <ul class="hero__proof" role="list" data-trip>
      {
        hero.proof.map((item) => (
          <li>
            <Icon name="check" size={18} />
            <span set:html={withData(item)} />
          </li>
        ))
      }
    </ul>
    <p class="visually-hidden">{hero.sceneLabel}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(100svh, 640px);
    padding-top: calc(var(--header-h) + 7rem);
    padding-bottom: clamp(2rem, 1rem + 4.5vh, 4.75rem);
    overflow: clip;
    background: var(--night-950);
    color: var(--dusk-50);
  }

  /* ---------- Stage: poster, live canvas, scrims ---------- */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 70% at 60% 45%, var(--night-800) 0%, var(--night-950) 70%);
  }
  .hero__stage picture,
  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__poster {
    object-fit: cover;
    object-position: 64% 50%;
    transform-origin: 70% 55%;
  }
  @media (max-aspect-ratio: 4/5) {
    .hero__poster {
      object-position: 50% 50%;
    }
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.1s var(--ease-out);
  }
  .hero.is-live .hero__canvas {
    opacity: 1;
  }

  /* Scrims guarantee headline and lede contrast over any part of the scene. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--night-900) 0%, rgb(12 22 40 / 0) 14%),
      radial-gradient(ellipse 72% 88% at 0% 100%, rgb(7 13 25 / 0.9) 0%, rgb(7 13 25 / 0.74) 46%, rgb(7 13 25 / 0) 100%),
      linear-gradient(to bottom, rgb(7 13 25 / 0.55) 0%, rgb(7 13 25 / 0) 22%);
  }

  /* ---------- Content ---------- */
  .hero__content {
    position: relative;
    z-index: 2;
  }
  .hero__title {
    max-width: 11.5ch;
    font-size: clamp(2.6rem, min(1.2rem + 4.6vw, 0.6rem + 9.5vh), 5.5rem);
    text-shadow: 0 2px 30px rgb(7 13 25 / 0.55);
  }
  .hero__title :global(.hero__line-mask) {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .hero__lede {
    margin-top: clamp(1.1rem, 0.8rem + 1vw, 1.75rem);
    max-width: 40ch;
    color: var(--dusk-200);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
  }
  .hero__ctas .btn--primary {
    font-variant-numeric: tabular-nums;
  }
  .hero__ghost {
    --btn-bg: rgb(7 13 25 / 0.45);
    --btn-border: rgb(195 205 225 / 0.38);
  }
  .hero__ghost:hover {
    --btn-bg: rgb(255 158 61 / 0.1);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--dusk-200);
  }
  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__proof :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--sodium-500);
  }
  .hero__proof :global(.hero__num) {
    font-family: var(--font-data);
    font-size: 0.88em;
    font-stretch: 88%;
    letter-spacing: 0.02em;
    color: var(--dusk-50);
  }

  /* ---------- HUD: CCTV on-screen display, hint, motion box ---------- */
  .hero__hud {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero__osd {
    position: absolute;
    top: calc(var(--header-h) + 0.9rem);
    right: max(var(--gutter), (100% - var(--max)) / 2);
    display: grid;
    justify-items: end;
    gap: 0.3rem;
    color: var(--dusk-50);
    text-shadow: 0 1px 2px rgb(3 7 15 / 0.8);
  }
  .hero__osd-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hero__rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sodium-500);
    box-shadow: 0 0 8px 1px var(--sodium-glow);
  }
  .hero__cam {
    transition: color var(--dur-trip) linear;
  }
  .hero.is-motion .hero__cam {
    color: var(--sodium-400);
  }
  .hero__time {
    color: var(--dusk-200);
    min-height: 1.2em;
  }

  .hero__hint {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    color: var(--flood-50);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .hero__hint.is-on {
    opacity: 1;
  }
  .hero__hint.is-muted {
    opacity: 0;
    transition-duration: 0.2s;
  }
  .hero__hint-ring {
    position: absolute;
    left: -20px;
    top: -7px;
    width: 40px;
    height: 14px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0.85;
  }
  .hero__hint-stem {
    position: absolute;
    left: -0.5px;
    bottom: 2px;
    width: 1px;
    height: 54px;
    background: linear-gradient(to top, currentColor, rgb(246 245 240 / 0.15));
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.7s var(--ease-out) 0.15s;
  }
  .hero__hint.is-on .hero__hint-stem {
    transform: scaleY(1);
  }
  .hero__hint-label {
    position: absolute;
    left: 0;
    bottom: 58px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem 0.45rem 0.6rem;
    border: 1px solid rgb(246 245 240 / 0.18);
    border-radius: var(--radius-sm);
    background: rgb(7 13 25 / 0.78);
    color: var(--flood-50);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    width: max-content;
    box-shadow: var(--shadow-1);
    transform: translateX(calc(-50% + var(--shift, 0px)));
  }
  .hero__glyph {
    flex: none;
    width: 18px;
    height: 18px;
    max-width: none;
    color: var(--sodium-400);
  }
  .hero__glyph--touch,
  .hero__hint.is-touch .hero__glyph--pointer {
    display: none;
  }
  .hero__hint.is-touch .hero__glyph--touch {
    display: block;
  }

  .hero__track {
    --c: 12px;
    --t: 1.5px;
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 90px;
    color: var(--sodium-400);
    opacity: 0;
    background:
      linear-gradient(currentColor 0 0) top left / var(--c) var(--t),
      linear-gradient(currentColor 0 0) top left / var(--t) var(--c),
      linear-gradient(currentColor 0 0) top right / var(--c) var(--t),
      linear-gradient(currentColor 0 0) top right / var(--t) var(--c),
      linear-gradient(currentColor 0 0) bottom left / var(--c) var(--t),
      linear-gradient(currentColor 0 0) bottom left / var(--t) var(--c),
      linear-gradient(currentColor 0 0) bottom right / var(--c) var(--t),
      linear-gradient(currentColor 0 0) bottom right / var(--t) var(--c);
    background-repeat: no-repeat;
    transition: opacity 0.9s var(--ease-out);
  }
  .hero__track.is-on {
    opacity: 1;
    transition-duration: 0.12s;
  }
  .hero__track .data {
    position: absolute;
    left: 0;
    bottom: calc(100% + 5px);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: var(--sodium-500);
    color: var(--night-950);
    font-size: 0.66rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* ---------- Motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__rec i {
      animation: rec 1.6s steps(1, end) infinite;
    }
    .hero.is-motion .hero__rec i {
      animation-duration: 0.5s;
    }
    .hero__hint.is-on .hero__hint-ring {
      animation: ring-pulse 2.2s var(--ease-out) infinite;
    }
    .hero__track.is-on {
      animation: box-trip 0.28s linear;
    }
  }
  @keyframes rec {
    50% {
      opacity: 0.15;
    }
  }
  @keyframes ring-pulse {
    0% {
      transform: scale(0.55);
      opacity: 0.95;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  @keyframes box-trip {
    0% { opacity: 0; }
    18% { opacity: 1; }
    32% { opacity: 0.3; }
    48%, 100% { opacity: 1; }
  }

  /* Entrance: hidden only when motion is allowed and the script will reveal it.
     The failsafe shows everything anyway if the script never runs. */
  :global(.hero-intro) .hero__title,
  :global(.hero-intro) [data-trip],
  :global(.hero-intro) .hero__osd {
    opacity: 0;
    animation: hero-failsafe 0.01s 2.4s forwards;
  }
  @keyframes hero-failsafe {
    to {
      opacity: 1;
    }
  }

  /* ---------- Layout by shape ---------- */
  @media (min-aspect-ratio: 5/4) and (min-width: 900px) {
    .hero {
      padding-top: calc(var(--header-h) + clamp(2rem, 9vh, 7rem));
    }
    .hero__title {
      max-width: 12ch;
    }
  }
  @media (max-aspect-ratio: 5/4), (max-width: 899px) {
    .hero {
      padding-top: calc(var(--header-h) + clamp(13rem, 36svh, 30rem));
    }
    .hero__scrim {
      background:
        linear-gradient(to top, var(--night-900) 0%, rgb(9 17 32 / 0.9) 42%, rgb(7 13 25 / 0.35) 58%, rgb(7 13 25 / 0) 70%),
        linear-gradient(to bottom, rgb(7 13 25 / 0.55) 0%, rgb(7 13 25 / 0) 20%);
    }
    .hero__lede {
      font-size: var(--step-0);
    }
  }
  @media (max-width: 519px) {
    .hero__ctas {
      display: grid;
    }
    .hero__osd {
      top: calc(var(--header-h) + 0.4rem);
      font-size: 0.66rem;
    }
    .hero__proof {
      display: grid;
      gap: 0.4rem;
    }
  }
</style>

<script>
  import { initHero } from '../scripts/hero/hero.js';
  initHero();
</script>
