  "font": {
    "family": {
      "display": {
        "$value": [
          "Cormorant Garamond",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ],
        "$type": "fontFamily"
      },
      "text": {
        "$value": [
          "Newsreader",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ],
        "$type": "fontFamily"
      },
      "ui": {
        "$value": [
          "Instrument Sans",
          "Helvetica Neue",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ],
        "$type": "fontFamily"
      }
    },
    "scale": {
      "display": {
        "family": "display",
        "size": {
          "$value": "clamp(3rem, 1.75rem + 4.5vw, 6.5rem)",
          "$type": "dimension"
        },
        "min": "48px",
        "max": "104px",
        "lineHeight": 1,
        "letterSpacing": "-0.02em",
        "weight": 300,
        "use": "Hero title, one per page"
      },
      "headline": {
        "family": "display",
        "size": {
          "$value": "clamp(2.125rem, 1.5rem + 2.4vw, 3.75rem)",
          "$type": "dimension"
        },
        "min": "34px",
        "max": "60px",
        "lineHeight": 1.06,
        "letterSpacing": "-0.015em",
        "weight": 400,
        "use": "Section titles, poem titles"
      },
      "title1": {
        "family": "display",
        "size": {
          "$value": "clamp(1.625rem, 1.35rem + 1vw, 2.375rem)",
          "$type": "dimension"
        },
        "min": "26px",
        "max": "38px",
        "lineHeight": 1.15,
        "letterSpacing": "-0.01em",
        "weight": 500,
        "use": "Card/article titles, dialog titles"
      },
      "title2": {
        "family": "text",
        "size": {
          "$value": "clamp(1.3125rem, 1.2rem + .5vw, 1.625rem)",
          "$type": "dimension"
        },
        "min": "21px",
        "max": "26px",
        "lineHeight": 1.25,
        "letterSpacing": "0",
        "weight": 500,
        "use": "Prose subheads"
      },
      "title3": {
        "family": "ui",
        "size": {
          "$value": "1.125rem",
          "$type": "dimension"
        },
        "lineHeight": 1.35,
        "weight": 600,
        "use": "UI headings"
      },
      "bodylg": {
        "family": "text",
        "size": {
          "$value": "clamp(1.125rem, 1.05rem + .35vw, 1.3125rem)",
          "$type": "dimension"
        },
        "min": "18px",
        "max": "21px",
        "lineHeight": 1.55,
        "weight": 400,
        "use": "Ledes, poems"
      },
      "body": {
        "family": "text",
        "size": {
          "$value": "1.0625rem",
          "$type": "dimension"
        },
        "lineHeight": 1.6,
        "weight": 400,
        "use": "Reading text"
      },
      "label": {
        "family": "ui",
        "size": {
          "$value": "0.9375rem",
          "$type": "dimension"
        },
        "lineHeight": 1.4,
        "weight": 500,
        "use": "Buttons, nav, form labels"
      },
      "caption": {
        "family": "ui",
        "size": {
          "$value": "0.8125rem",
          "$type": "dimension"
        },
        "lineHeight": 1.45,
        "letterSpacing": "0.01em",
        "weight": 400,
        "use": "Meta, help text"
      },
      "overline": {
        "family": "ui",
        "size": {
          "$value": "0.75rem",
          "$type": "dimension"
        },
        "lineHeight": 1.4,
        "letterSpacing": "0.12em",
        "weight": 500,
        "transform": "uppercase",
        "use": "Eyebrows, badges"
      }
    },
