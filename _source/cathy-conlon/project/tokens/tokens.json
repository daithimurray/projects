  },
  "shadow": {
    "1": {
      "$value": "0 1px 2px rgb(28 25 23 / .06)",
      "$type": "shadow"
    },
    "2": {
      "$value": "0 4px 16px -4px rgb(28 25 23 / .10), 0 1px 2px rgb(28 25 23 / .05)",
      "$type": "shadow"
    },
    "3": {
      "$value": "0 24px 48px -16px rgb(28 25 23 / .22), 0 2px 6px rgb(28 25 23 / .06)",
      "$type": "shadow"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "120ms",
        "$type": "duration"
      },
      "base": {
        "$value": "200ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "360ms",
        "$type": "duration"
      },
      "page": {
        "$value": "600ms",
        "$type": "duration"
      }
    },
    "easing": {
      "out": {
        "$value": [
          0.2,
          0.7,
          0.2,
          1
        ],
        "$type": "cubicBezier"
      },
      "inOut": {
        "$value": [
          0.65,
          0,
          0.35,
          1
        ],
        "$type": "cubicBezier"
      },
      "emphasis": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$type": "cubicBezier"
      }
    }
  },
