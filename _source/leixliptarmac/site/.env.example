# Where the consultation form POSTs its JSON. Any JSON form endpoint works (Formspree, Basin, a serverless function).
# Without it the form shows "That didn't send" with Barry's and John's numbers.
PUBLIC_FORM_ENDPOINT=

# Demo deploys (e.g. getawebsite.ie/leixliptarmac): keep the copy out of Google so it doesn't compete with leixliptarmac.com.
PUBLIC_NOINDEX=1
SITE_URL=https://getawebsite.ie
BASE_PATH=/leixliptarmac
